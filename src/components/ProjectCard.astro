---
import { parsePartialDate, buildDateLabel } from "../utils/dates";

interface Props {
    title: string;
    description: string;
    startDate?: string | Date;
    endDate?: string | Date;
    tags?: string[];
    image?: string;
    projectSlug?: string;
    externalUrl?: string;
    lang?: "fr" | "en";
}

const {
    title,
    description,
    startDate,
    endDate,
    tags = [],
    image,
    projectSlug,
    externalUrl,
    lang = "fr",
} = Astro.props;

const dateLabel = buildDateLabel(startDate, endDate, lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const projectLink = projectSlug ? `${base}${lang}/projects/${projectSlug}` : externalUrl;
const isExternal = Boolean(!projectSlug && externalUrl);
---

<article class="project-card bento-card">
    {projectLink && (
        <a
            href={projectLink}
            class="project-card__overlay-link"
            aria-label={title}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
        />
    )}

    {image && (
        <div class="project-card__image-wrap">
            <img src={image.startsWith("/") ? `${base}${image.replace(/^\//, "")}` : image} alt={title} loading="lazy" />
        </div>
    )}

    <div class="project-card__body">
        <div class="project-card__header">
            <span class="project-card__date">{dateLabel}</span>
            {isExternal && <span class="project-card__ext-badge">↗</span>}
        </div>

        <h3 class="project-card__title">{title}</h3>
        <p class="project-card__description">{description}</p>

        {tags.length > 0 && (
            <div class="project-card__tags">
                {tags.map((tag) => (
                    <span class="tag-pill">{tag}</span>
                ))}
            </div>
        )}

        <div class="project-card__footer">
            <span class="project-card__cta">
                {lang === "fr" ? "En savoir plus →" : "Read more →"}
            </span>
        </div>
    </div>
</article>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .project-card__overlay-link {
        position: absolute;
        inset: 0;
        z-index: 2;
    }

    .project-card__image-wrap {
        width: 100%;
        height: 180px;
        overflow: hidden;
        border-radius: var(--radius-lg);
        margin-bottom: var(--space-4);
        background: var(--color-background-secondary);
    }

    .project-card__image-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--transition-base);
    }

    .project-card:hover .project-card__image-wrap img {
        transform: scale(1.05);
    }

    .project-card__body {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .project-card__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--space-2);
    }

    .project-card__date {
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--color-primary);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .project-card__ext-badge {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
    }

    .project-card__title {
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--color-text);
        margin-bottom: var(--space-2);
        line-height: 1.3;
    }

    .project-card__description {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin-bottom: var(--space-4);
        flex: 1;
    }

    .project-card__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-bottom: var(--space-4);
    }

    .tag-pill {
        display: inline-block;
        padding: 3px 9px;
        background: color-mix(in srgb, var(--color-primary) 7%, transparent);
        border: 1px solid color-mix(in srgb, var(--color-primary) 18%, transparent);
        color: var(--color-primary-dark);
        border-radius: var(--radius-full);
        font-size: var(--text-xs);
        font-weight: 600;
    }

    :global([data-theme="dark"]) .tag-pill {
        background: color-mix(in srgb, var(--color-primary) 12%, transparent);
        border-color: color-mix(in srgb, var(--color-primary) 25%, transparent);
        color: var(--color-primary);
    }

    .project-card__footer {
        margin-top: auto;
        padding-top: var(--space-2);
    }

    .project-card__cta {
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--color-primary);
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: transform var(--transition-fast);
    }

    .project-card:hover .project-card__cta {
        transform: translateX(4px);
    }
</style>
