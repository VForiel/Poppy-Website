---
import { parsePartialDate, formatPartialDate, buildDateLabel } from "../utils/dates";

interface Props {
    projects: Array<{
        slug: string;
        data: {
            title: string;
            description: string;
            "start-date"?: string | Date;
            "end-date"?: string | Date;
            tags: string[];
            image?: string;
            featured?: boolean;
            url?: string;
        };
    }>;
    lang: "fr" | "en";
}

const { projects, lang } = Astro.props;
const allTags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const labels = {
    fr: {
        filterLabel: "Filtrer par thématique :",
        all: "Tout afficher",
        ongoing: "En cours",
        readMore: "Détails du projet →",
    },
    en: {
        filterLabel: "Filter by theme:",
        all: "Show all",
        ongoing: "Ongoing",
        readMore: "Project details →",
    },
}[lang];
---

<div class="timeline-container">
    {allTags.length > 0 && (
        <div class="timeline-filters">
            <span class="filters-label">{labels.filterLabel}</span>
            <div class="filter-pills" id="timelineFilterPills">
                <button class="filter-btn active" data-tag="all">
                    {labels.all}
                </button>
                {allTags.map((tag) => (
                    <button class="filter-btn" data-tag={tag}>
                        {tag}
                    </button>
                ))}
            </div>
        </div>
    )}

    <div class="timeline" id="timelineList">
        {projects.map((project) => {
            const cleanSlug = project.id.replace(/\.?(fr|en)$/, "");
            const dateLabel = buildDateLabel(project.data["start-date"], project.data["end-date"], lang);
            const projectLink = `${base}${lang}/projects/${cleanSlug}`;

            return (
                <div 
                    class="timeline-item" 
                    data-tags={JSON.stringify(project.data.tags)}
                >
                    <div class="timeline-marker">
                        <span class="marker-dot"></span>
                        <span class="marker-line"></span>
                    </div>

                    <div class="timeline-card bento-card">
                        <div class="timeline-date">{dateLabel}</div>
                        <h3 class="timeline-title">
                            <a href={projectLink}>{project.data.title}</a>
                        </h3>
                        <p class="timeline-desc">{project.data.description}</p>

                        <div class="timeline-tags">
                            {project.data.tags.map((tag) => (
                                <span class="tag-pill">{tag}</span>
                            ))}
                        </div>

                        <a href={projectLink} class="timeline-link">
                            {labels.readMore}
                        </a>
                    </div>
                </div>
            );
        })}
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const filterBtns = document.querySelectorAll(".filter-btn");
        const items = document.querySelectorAll(".timeline-item");

        function updateTimelineLines() {
            const visibleItems = Array.from(items).filter(
                (item) => (item as HTMLElement).style.display !== "none"
            );

            visibleItems.forEach((item, index) => {
                const line = item.querySelector(".marker-line") as HTMLElement | null;
                if (line) {
                    line.style.display = index === visibleItems.length - 1 ? "none" : "";
                }
            });
        }

        filterBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const targetTag = btn.getAttribute("data-tag");

                filterBtns.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");

                items.forEach((item) => {
                    const tagsStr = item.getAttribute("data-tags") || "[]";
                    const itemTags: string[] = JSON.parse(tagsStr);

                    if (targetTag === "all" || itemTags.includes(targetTag || "")) {
                        (item as HTMLElement).style.display = "flex";
                    } else {
                        (item as HTMLElement).style.display = "none";
                    }
                });

                updateTimelineLines();
            });
        });

        updateTimelineLines();
    });
</script>

<style>
    .timeline-container {
        position: relative;
        width: 100%;
    }

    .timeline-filters {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        margin-bottom: var(--space-8);
        padding-bottom: var(--space-6);
        border-bottom: 1px solid var(--color-border);
    }

    .filters-label {
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--color-text-secondary);
    }

    .filter-pills {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }

    .filter-btn {
        position: relative;
        isolation: isolate;
        padding: 6px 10px;
        border: 0;
        background: none;
        color: var(--color-text-secondary);
        font-size: var(--text-xs);
        font-weight: 600;
        cursor: pointer;
        transition: color var(--transition-fast);
    }

    /* même trait de pinceau que le menu : esquissé au survol, plein sur le filtre actif */
    .filter-btn::after {
        content: '';
        position: absolute;
        inset: 40% 2px 2px;
        z-index: -1;
        background-color: color-mix(in srgb, var(--color-sage) 55%, transparent);
        -webkit-mask: var(--paint-stroke) center / 100% 100% no-repeat;
        mask: var(--paint-stroke) center / 100% 100% no-repeat;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform var(--transition-slow);
    }

    .filter-btn:hover {
        color: var(--color-text);
    }

    .filter-btn:hover::after {
        transform: scaleX(0.6);
    }

    .filter-btn.active {
        color: var(--color-text);
        font-weight: 700;
    }

    .filter-btn.active::after {
        transform: scaleX(1);
        background-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
    }

    .timeline {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        position: relative;
    }

    .timeline-item {
        display: flex;
        gap: var(--space-6);
        position: relative;
    }

    .timeline-marker {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        width: 24px;
        position: relative;
    }

    .marker-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--color-primary);
        border: 2px solid var(--color-background);
        box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary) 20%, transparent), 0 2px 8px color-mix(in srgb, var(--color-primary) 15%, transparent);
        margin-top: var(--space-6);
        position: relative;
        z-index: 2;
        flex-shrink: 0;
        transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    }

    :global([data-theme="dark"]) .marker-dot {
        box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary) 30%, transparent), 0 0 10px color-mix(in srgb, var(--color-primary) 40%, transparent);
    }

    .timeline-item:hover .marker-dot {
        transform: scale(1.15);
    }

    .marker-line {
        position: absolute;
        top: calc(var(--space-6) + 7px);
        bottom: calc(-2 * var(--space-6) - 7px);
        left: 50%;
        transform: translateX(-50%);
        width: 2px;
        background: linear-gradient(
            to bottom,
            var(--color-primary) 0%,
            var(--color-border) 45%,
            var(--color-border) 55%,
            var(--color-primary) 100%
        );
        z-index: 1;
    }

    :global([data-theme="dark"]) .marker-line {
        background: linear-gradient(
            to bottom,
            var(--color-primary) 0%,
            color-mix(in srgb, var(--color-primary) 35%, transparent) 50%,
            var(--color-primary) 100%
        );
    }

    .timeline-item:last-child .marker-line {
        display: none;
    }

    .timeline-card {
        flex: 1;
        padding: var(--space-6);
    }

    .timeline-date {
        font-size: var(--text-xs);
        font-weight: 700;
        color: var(--color-primary);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: var(--space-2);
    }

    .timeline-title {
        font-size: var(--text-xl);
        font-weight: 600;
        margin-bottom: var(--space-2);
    }

    .timeline-title a {
        color: var(--color-text);
        text-decoration: none;
    }

    .timeline-title a:hover {
        color: var(--color-primary);
    }

    .timeline-desc {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin-bottom: var(--space-4);
        max-width: none;
    }

    .timeline-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-bottom: var(--space-4);
    }

    .tag-pill {
        display: inline-block;
        padding: 3px 9px;
        background: color-mix(in srgb, var(--color-primary) 7%, transparent);
        border: 1px solid color-mix(in srgb, var(--color-primary) 18%, transparent);
        color: var(--color-primary-dark);
        border-radius: var(--radius-full);
        font-size: var(--text-xs);
        font-weight: 600;
    }

    :global([data-theme="dark"]) .tag-pill {
        background: color-mix(in srgb, var(--color-primary) 12%, transparent);
        border-color: color-mix(in srgb, var(--color-primary) 25%, transparent);
        color: var(--color-primary);
    }

    .timeline-link {
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--color-primary);
        display: inline-block;
        transition: transform var(--transition-fast);
    }

    .timeline-link:hover {
        transform: translateX(4px);
    }

    @media (max-width: 640px) {
        .timeline-marker {
            display: none;
        }
        .timeline-item {
            gap: 0;
        }
    }
</style>
