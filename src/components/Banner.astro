---
interface Props {
    lang: string;
}

const { lang } = Astro.props;

const content = {
    fr: {
        badge: "Actualité & Perspectives 2026-2027",
        title: "Projets de Cabinet Libéral, Formations & Recherche de Post-Doc",
        description: "En fin de thèse au CE2P de l'Hôpital Lenval (soutenance été 2027), je prépare l'ouverture de mon cabinet libéral à Nice et suis ouverte aux propositions de post-doctorat et missions de formation sur le psychotrauma chez les 3-6 ans.",
        cta: "Me contacter",
        contactUrl: "/fr/contact",
    },
    en: {
        badge: "News & Outlook 2026-2027",
        title: "Private Practice Launch, Training & Post-Doctoral Research",
        description: "Completing my PhD at Lenval Hospital's CE2P (defense planned for summer 2027), I am preparing the opening of my private clinical practice in Nice and welcoming post-doctoral research collaborations and professional training inquiries on early childhood trauma.",
        cta: "Get in touch",
        contactUrl: "/en/contact",
    },
}[lang as "fr" | "en"] || {
    badge: "Actualité & Perspectives",
    title: "Projets de Cabinet Libéral & Recherche de Post-Doc",
    description: "Doctorante Lenval CE2P, ouverte aux opportunités de post-doctorat, missions de formation et ouverture prochaine de cabinet libéral.",
    cta: "Me contacter",
    contactUrl: "/fr/contact",
};

const base = import.meta.env.BASE_URL.replace(/\/?$/, "");
---

<!-- Icon to reopen banner -->
<button
    id="reopen-banner"
    class="reopen-banner"
    aria-label="Rouvrir l'annonce d'opportunité"
    title={content.badge}
>
    <div class="banner-indicator reopen-indicator">
        <span class="pulse-dot"></span>
    </div>
    <span class="reopen-icon">✨</span>
    <span class="reopen-text">{lang === 'fr' ? 'Opportunités' : 'Opportunities'}</span>
</button>

<!-- Main Banner Modal -->
<div id="availability-banner" class="availability-banner" role="alert">
    <div class="banner-content">
        <div class="banner-indicator">
            <span class="pulse-dot"></span>
        </div>
        <div class="banner-text">
            <span class="banner-badge">{content.badge}</span>
            <strong class="banner-title">{content.title}</strong>
            <p class="banner-desc">{content.description}</p>
        </div>
        <div class="banner-actions">
            <a
                href={`${base}${content.contactUrl}`}
                class="banner-cta button button--primary"
                id="banner-cta"
            >
                {content.cta}
            </a>
            <button
                id="close-banner"
                class="banner-close"
                aria-label="Fermer la notification"
            >
                ✕
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const banner = document.getElementById("availability-banner");
        const closeBtn = document.getElementById("close-banner");
        const ctaBtn = document.getElementById("banner-cta");
        const reopenBtn = document.getElementById("reopen-banner");

        const isDismissed = localStorage.getItem("banner-dismissed-poppy") === "true";

        if (!isDismissed) {
            setTimeout(() => {
                banner?.classList.add("show");
            }, 800);
        } else {
            setTimeout(() => {
                reopenBtn?.classList.add("show");
            }, 400);
        }

        const closeBanner = () => {
            banner?.classList.remove("show");
            setTimeout(() => {
                reopenBtn?.classList.add("show");
            }, 300);
            localStorage.setItem("banner-dismissed-poppy", "true");
        };

        const openBanner = () => {
            reopenBtn?.classList.remove("show");
            setTimeout(() => {
                banner?.classList.add("show");
            }, 200);
            localStorage.removeItem("banner-dismissed-poppy");
        };

        closeBtn?.addEventListener("click", closeBanner);
        ctaBtn?.addEventListener("click", closeBanner);
        reopenBtn?.addEventListener("click", openBanner);
    });
</script>

<style>
    .availability-banner {
        position: fixed;
        bottom: var(--space-6);
        left: 50%;
        transform: translate(-50%, 150%);
        width: calc(100% - var(--space-8));
        max-width: 820px;
        background: hsla(224, 25%, 12%, 0.94);
        border: 1px solid var(--color-primary);
        box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.7), var(--glow-primary);
        border-radius: var(--radius-xl);
        padding: var(--space-5) var(--space-6);
        z-index: 99;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        transition: transform var(--transition-slow), opacity var(--transition-slow);
        opacity: 0;
    }

    :global(.light-theme) .availability-banner,
    [data-theme="light"] .availability-banner {
        background: hsla(0, 0%, 100%, 0.94);
        box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.15), var(--glow-primary);
    }

    .availability-banner.show {
        transform: translate(-50%, 0);
        opacity: 1;
    }

    .banner-content {
        display: flex;
        align-items: center;
        gap: var(--space-4);
    }

    .banner-indicator {
        flex-shrink: 0;
    }

    .banner-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .banner-badge {
        font-size: var(--text-xs);
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-accent);
        letter-spacing: 0.05em;
    }

    .banner-title {
        font-size: var(--text-base);
        color: var(--color-text);
        line-height: 1.3;
    }

    .banner-desc {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.4;
        margin-top: 2px;
        max-width: none;
    }

    .banner-actions {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-shrink: 0;
    }

    .banner-close {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        font-size: 1.2rem;
        cursor: pointer;
        padding: 4px;
        transition: color var(--transition-fast);
        line-height: 1;
    }

    .banner-close:hover {
        color: var(--color-text);
    }

    /* Floating Reopen Pill Button */
    .reopen-banner {
        position: fixed;
        bottom: var(--space-6);
        right: var(--space-6);
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-full);
        background: var(--color-background-card);
        border: 1px solid var(--color-border);
        color: var(--color-text);
        box-shadow: var(--shadow-lg);
        backdrop-filter: blur(10px);
        cursor: pointer;
        z-index: 98;
        transform: translateY(120px);
        opacity: 0;
        transition: all var(--transition-base);
    }

    .reopen-banner.show {
        transform: translateY(0);
        opacity: 1;
    }

    .reopen-banner:hover {
        border-color: var(--color-primary);
        box-shadow: var(--glow-primary);
        transform: translateY(-2px);
    }

    .reopen-text {
        font-size: var(--text-xs);
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .banner-content {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-3);
        }

        .banner-actions {
            width: 100%;
            justify-content: space-between;
        }

        .availability-banner {
            bottom: var(--space-4);
            width: calc(100% - var(--space-6));
            padding: var(--space-4);
        }
    }
</style>
