---
interface Props {
    lang: string;
}

const { lang } = Astro.props;

const content = {
    fr: {
        title: "Recherche de Post-Doctorat & Missions de Formation",
        description: "En 4ᵉ année de doctorat au CE2P de l'Hôpital Lenval (soutenance mi-2027), je suis à l'écoute d'opportunités de post-doctorat et disponible pour concevoir des formations spécialisées sur le psychotrauma des 3–6 ans (TCC & EMDR).",
        cta: "Prendre contact",
        contactUrl: "/fr/contact",
    },
    en: {
        title: "Post-Doctoral Opportunities & Professional Training",
        description: "In the 4th year of doctoral research at Lenval Children's Hospital (defense mid-2027), I am actively exploring post-doctoral positions and available for specialized clinical training modules on early childhood psychotrauma (CBT & EMDR).",
        cta: "Get in touch",
        contactUrl: "/en/contact",
    },
}[lang as "fr" | "en"] || {
    title: "Recherche de Post-Doctorat & Missions de Formation",
    description: "Doctorante Lenval CE2P, ouverte aux opportunités de post-doctorat et aux missions de formation spécialisées.",
    cta: "Prendre contact",
    contactUrl: "/fr/contact",
};

const base = import.meta.env.BASE_URL.replace(/\/?$/, "");
---

<!-- Icon to reopen banner -->
<button
    id="reopen-banner"
    class="reopen-banner"
    aria-label="Rouvrir l'annonce d'opportunité"
    title={content.title}
>
    <div class="banner-indicator reopen-indicator">
        <span class="pulse-dot"></span>
    </div>
    <span class="reopen-icon">✨</span>
    <span class="reopen-text">{lang === 'fr' ? 'Opportunités' : 'Opportunities'}</span>
</button>

<!-- Main Banner Modal -->
<div id="availability-banner" class="availability-banner" role="alert">
    <div class="banner-content">
        <div class="banner-indicator">
            <span class="pulse-dot"></span>
        </div>
        <div class="banner-text">
            <strong class="banner-title">{content.title}</strong>
            <p class="banner-desc">{content.description}</p>
        </div>
        <div class="banner-actions">
            <a
                href={`${base}${content.contactUrl}`}
                class="banner-cta button button--primary"
                id="banner-cta"
            >
                {content.cta}
            </a>
            <button
                id="close-banner"
                class="banner-close"
                aria-label="Fermer la notification"
            >
                ✕
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const banner = document.getElementById("availability-banner");
        const closeBtn = document.getElementById("close-banner");
        const ctaBtn = document.getElementById("banner-cta");
        const reopenBtn = document.getElementById("reopen-banner");

        const isDismissed = localStorage.getItem("banner-dismissed-poppy") === "true";

        if (!isDismissed) {
            setTimeout(() => {
                banner?.classList.add("show");
            }, 800);
        } else {
            setTimeout(() => {
                reopenBtn?.classList.add("show");
            }, 400);
        }

        const closeBanner = () => {
            banner?.classList.remove("show");
            setTimeout(() => {
                reopenBtn?.classList.add("show");
            }, 300);
            localStorage.setItem("banner-dismissed-poppy", "true");
        };

        const openBanner = () => {
            reopenBtn?.classList.remove("show");
            setTimeout(() => {
                banner?.classList.add("show");
            }, 200);
            localStorage.removeItem("banner-dismissed-poppy");
        };

        closeBtn?.addEventListener("click", closeBanner);
        ctaBtn?.addEventListener("click", closeBanner);
        reopenBtn?.addEventListener("click", openBanner);
    });
</script>

<style>
    .availability-banner {
        position: fixed;
        bottom: var(--space-6);
        left: 50%;
        transform: translate(-50%, 150%);
        width: calc(100% - var(--space-8));
        max-width: 820px;
        background: #ffffff;
        border: 1px solid hsla(168, 80%, 28%, 0.3);
        box-shadow: 0 16px 45px -10px rgba(15, 23, 42, 0.16), 0 0 25px hsla(168, 80%, 28%, 0.12);
        border-radius: var(--radius-xl);
        padding: var(--space-5) var(--space-6);
        z-index: 99;
        transition: transform var(--transition-slow), opacity var(--transition-slow);
        opacity: 0;
    }

    :global([data-theme="dark"]) .availability-banner {
        background: hsla(224, 25%, 12%, 0.95);
        border-color: var(--color-primary);
        box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.7), var(--glow-primary);
    }

    .availability-banner.show {
        transform: translate(-50%, 0);
        opacity: 1;
    }

    .banner-content {
        display: flex;
        align-items: center;
        gap: var(--space-4);
    }

    .banner-indicator {
        flex-shrink: 0;
    }

    .banner-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .banner-title {
        font-size: var(--text-base);
        color: var(--color-text);
        line-height: 1.3;
    }

    .banner-desc {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.4;
        margin-top: 2px;
        max-width: none;
    }

    .banner-actions {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-shrink: 0;
    }

    .banner-close {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        font-size: 1.2rem;
        cursor: pointer;
        padding: 4px;
        transition: color var(--transition-fast);
        line-height: 1;
    }

    .banner-close:hover {
        color: var(--color-text);
    }

    /* Floating Reopen Pill Button */
    .reopen-banner {
        position: fixed;
        bottom: var(--space-6);
        right: var(--space-6);
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-full);
        background: var(--color-background-card);
        border: 1px solid var(--color-border);
        color: var(--color-text);
        box-shadow: var(--shadow-md);
        cursor: pointer;
        z-index: 98;
        transform: translateY(120px);
        opacity: 0;
        transition: all var(--transition-base);
    }

    .reopen-banner.show {
        transform: translateY(0);
        opacity: 1;
    }

    .reopen-banner:hover {
        border-color: var(--color-primary);
        box-shadow: var(--glow-primary);
        transform: translateY(-2px);
    }

    .reopen-text {
        font-size: var(--text-xs);
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .banner-content {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-3);
        }

        .banner-actions {
            width: 100%;
            justify-content: space-between;
        }

        .availability-banner {
            bottom: var(--space-4);
            width: calc(100% - var(--space-6));
            padding: var(--space-4);
        }
    }
</style>
