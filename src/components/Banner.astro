---
import InkIcon from "../components/InkIcon.astro";
interface Props {
    lang: string;
}

const { lang } = Astro.props;

const content = {
    fr: {
        title: "Recherche de Post-Doctorat & Missions de Formation",
        description: "En 4ᵉ année de doctorat au CE2P de l'Hôpital Lenval (soutenance mi-2027), je suis à l'écoute d'opportunités de post-doctorat et disponible pour concevoir des formations spécialisées sur le psychotrauma des 3–6 ans (TCC & EMDR).",
        cta: "Prendre contact",
        contactUrl: "/fr/contact",
    },
    en: {
        title: "Post-Doctoral Opportunities & Professional Training",
        description: "In the 4th year of doctoral research at Lenval Children's Hospital (defense mid-2027), I am actively exploring post-doctoral positions and available for specialized clinical training modules on early childhood psychotrauma (CBT & EMDR).",
        cta: "Get in touch",
        contactUrl: "/en/contact",
    },
}[lang as "fr" | "en"] || {
    title: "Recherche de Post-Doctorat & Missions de Formation",
    description: "Doctorante Lenval CE2P, ouverte aux opportunités de post-doctorat et aux missions de formation spécialisées.",
    cta: "Prendre contact",
    contactUrl: "/fr/contact",
};

const base = import.meta.env.BASE_URL.replace(/\/?$/, "");
---

<!-- Icon to reopen banner -->
<button
    id="reopen-banner"
    class="reopen-banner"
    aria-label="Rouvrir l'annonce d'opportunité"
    title={content.title}
>
    <InkIcon name="sparkle" size="sm" class="reopen-icon" />
    <span class="reopen-text">{lang === 'fr' ? 'Opportunités' : 'Opportunities'}</span>
</button>

<!-- Main Banner Modal -->
<div id="availability-banner" class="availability-banner" role="alert">
    <div class="banner-content">
        <InkIcon name="sparkle" size="md" class="banner-indicator" />
        <div class="banner-text">
            <strong class="banner-title">{content.title}</strong>
            <p class="banner-desc">{content.description}</p>
        </div>
        <div class="banner-actions">
            <a
                href={`${base}${content.contactUrl}`}
                class="banner-cta button button--primary"
                id="banner-cta"
            >
                {content.cta}
            </a>
            <button
                id="close-banner"
                class="banner-close"
                aria-label="Fermer la notification"
            >
                ✕
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const banner = document.getElementById("availability-banner");
        const closeBtn = document.getElementById("close-banner");
        const ctaBtn = document.getElementById("banner-cta");
        const reopenBtn = document.getElementById("reopen-banner");

        const isDismissed = localStorage.getItem("banner-dismissed-poppy") === "true";

        if (!isDismissed) {
            setTimeout(() => {
                banner?.classList.add("show");
            }, 3200);
        } else {
            setTimeout(() => {
                reopenBtn?.classList.add("show");
            }, 400);
        }

        const closeBanner = () => {
            banner?.classList.remove("show");
            setTimeout(() => {
                reopenBtn?.classList.add("show");
            }, 300);
            localStorage.setItem("banner-dismissed-poppy", "true");
        };

        const openBanner = () => {
            reopenBtn?.classList.remove("show");
            setTimeout(() => {
                banner?.classList.add("show");
            }, 200);
            localStorage.removeItem("banner-dismissed-poppy");
        };

        closeBtn?.addEventListener("click", closeBanner);
        ctaBtn?.addEventListener("click", closeBanner);
        reopenBtn?.addEventListener("click", openBanner);
    });
</script>

<style>
    /* Petit mot épinglé en bas à droite : papier, cadre à l'encre, sans pop-up plein écran */
    .availability-banner,
    .reopen-banner {
        position: fixed;
        right: var(--space-6);
        bottom: var(--space-6);
        z-index: 99;
        background: var(--color-background-card);
        border: 0;
        border-radius: 3px;
        box-shadow: 0 14px 30px -18px rgba(43, 42, 36, 0.45);
        opacity: 0;
        transform: translate3d(0, 130%, 0) rotate(1.5deg);
        transition: transform var(--transition-slow), opacity var(--transition-slow);
    }

    .availability-banner::before,
    .reopen-banner::before {
        content: '';
        position: absolute;
        inset: -2px;
        background-color: color-mix(in srgb, var(--color-ink) 60%, transparent);
        -webkit-mask: var(--ink-frame-card) center / 100% 100% no-repeat;
        mask: var(--ink-frame-card) center / 100% 100% no-repeat;
        pointer-events: none;
    }

    .availability-banner {
        width: min(350px, calc(100% - var(--space-8)));
        padding: var(--space-5);
    }

    .availability-banner.show,
    .reopen-banner.show {
        opacity: 1;
        transform: translate3d(0, 0, 0) rotate(-0.6deg);
    }

    .banner-content {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: var(--space-3) var(--space-4);
        align-items: start;
    }

    .banner-text {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .banner-title {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: 600;
        line-height: 1.3;
        color: var(--color-text);
    }

    .banner-desc {
        font-size: var(--text-sm);
        line-height: 1.55;
        max-width: none;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .banner-actions {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        margin-top: var(--space-2);
    }

    .banner-close {
        background: none;
        border: 0;
        padding: 4px 8px;
        font-size: var(--text-xs);
        letter-spacing: 0.06em;
        color: var(--color-text-muted);
        cursor: pointer;
    }

    .banner-close:hover {
        color: var(--color-text);
    }

    .reopen-banner {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
        color: var(--color-text);
        cursor: pointer;
        z-index: 98;
    }

    .reopen-banner.show:hover {
        transform: translate3d(0, -2px, 0) rotate(0deg);
    }

    .reopen-text {
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    @media (max-width: 640px) {
        .banner-desc {
            display: none;
        }

        .availability-banner,
        .reopen-banner {
            right: var(--space-4);
            bottom: var(--space-4);
        }
    }
</style>
