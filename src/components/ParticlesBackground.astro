---
// Animated Neural & Synaptic Psychology Background
// High-performance, organic non-linear curved synaptic flow with pediatric emblems
// 60/120 FPS buttery smooth scrolling with off-main-thread GPU ambient glows
---

<div class="synapses-bg" id="synapses-bg" aria-hidden="true">
    <div class="ambient-aura ambient-aura--green"></div>
    <div class="ambient-aura ambient-aura--rose"></div>
    <canvas id="synapses-canvas"></canvas>
</div>

<script>
    interface SynapticNode {
        x: number;
        y: number;
        baseSpeed: number;
        speedPhase: number;
        speedRate: number;
        angle: number;
        angularDrift: number;
        curveOffset: number;
        radius: number;
        colorType: 'sage' | 'rose' | 'amber';
        shapeType: 'dot' | 'flower' | 'heart' | 'bear';
        pulsePhase: number;
        pulseSpeed: number;
    }

    class SynapticNetwork {
        private canvas: HTMLCanvasElement;
        private ctx: CanvasRenderingContext2D;
        private nodes: SynapticNode[] = [];
        private mouse = { x: -2000, y: -2000, active: false };
        private animationFrameId: number = 0;
        private isVisible: boolean = true;
        private isDark: boolean = false;
        private isScrolling: boolean = false;
        private scrollTimeout: number = 0;
        private lastTime: number = 0;
        private hasPointerFine: boolean = true;

        constructor(canvas: HTMLCanvasElement) {
            this.canvas = canvas;
            this.ctx = canvas.getContext('2d', { alpha: true })!;
            this.hasPointerFine = window.matchMedia('(pointer: fine)').matches;
            this.checkTheme();
            this.resize();
            this.initNodes();
            this.bindEvents();
            this.lastTime = performance.now();
            this.animate(this.lastTime);
        }

        private checkTheme() {
            this.isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        }

        private resize() {
            // Cap DPR at 1 for background canvas: visually indistinguishable for diffuse particles,
            // but saves up to 4x GPU fill-rate on Retina / 4K displays
            const dpr = Math.min(window.devicePixelRatio || 1, 1.25);
            const w = window.innerWidth;
            const h = window.innerHeight;
            this.canvas.width = Math.floor(w * dpr);
            this.canvas.height = Math.floor(h * dpr);
            this.ctx.setTransform(1, 0, 0, 1, 0, 0);
            this.ctx.scale(dpr, dpr);
            this.canvas.style.width = `${w}px`;
            this.canvas.style.height = `${h}px`;
        }

        private initNodes() {
            this.nodes = [];
            const isMobile = window.innerWidth < 768;
            // Optimal count: 18 nodes on desktop, 10 on mobile
            const count = isMobile ? 10 : Math.min(Math.floor(window.innerWidth / 70), 20);
            const types: ('sage' | 'rose' | 'amber')[] = ['sage', 'sage', 'rose', 'amber'];
            const w = window.innerWidth;
            const h = window.innerHeight;

            for (let i = 0; i < count; i++) {
                const type = types[i % types.length];
                const radius = Math.random() * 1.6 + 1.8;

                // Exactly 1 flower, 1 heart, 1 teddy bear, all other particles remain dots
                let shapeType: 'dot' | 'flower' | 'heart' | 'bear' = 'dot';
                let startX = Math.random() * w;
                let startY = Math.random() * h;

                if (i === 1) {
                    shapeType = 'flower';
                    startX = w * 0.25 + (Math.random() - 0.5) * 120;
                    startY = h * 0.35 + (Math.random() - 0.5) * 100;
                } else if (i === 2) {
                    shapeType = 'heart';
                    startX = w * 0.75 + (Math.random() - 0.5) * 120;
                    startY = h * 0.40 + (Math.random() - 0.5) * 100;
                } else if (i === 3) {
                    shapeType = 'bear';
                    startX = w * 0.50 + (Math.random() - 0.5) * 120;
                    startY = h * 0.70 + (Math.random() - 0.5) * 100;
                }

                this.nodes.push({
                    x: Math.max(20, Math.min(w - 20, startX)),
                    y: Math.max(20, Math.min(h - 20, startY)),
                    baseSpeed: Math.random() * 0.18 + 0.25,
                    speedPhase: Math.random() * Math.PI * 2,
                    speedRate: Math.random() * 0.001 + 0.0006,
                    angle: Math.random() * Math.PI * 2,
                    angularDrift: (Math.random() - 0.5) * 0.01,
                    curveOffset: Math.random() * 100,
                    radius,
                    colorType: type,
                    shapeType,
                    pulsePhase: Math.random() * Math.PI * 2,
                    pulseSpeed: Math.random() * 0.02 + 0.01,
                });
            }
        }

        private bindEvents() {
            let resizeTimeout: number;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = window.setTimeout(() => {
                    this.hasPointerFine = window.matchMedia('(pointer: fine)').matches;
                    this.resize();
                    this.initNodes();
                }, 150);
            }, { passive: true });

            // Scroll throttle: skip heavy synaptic lines & throttle canvas during scroll
            // for uncompromised 120 FPS butter-smooth document scrolling
            window.addEventListener('scroll', () => {
                this.isScrolling = true;
                clearTimeout(this.scrollTimeout);
                this.scrollTimeout = window.setTimeout(() => {
                    this.isScrolling = false;
                }, 70);
            }, { passive: true });

            if (this.hasPointerFine) {
                window.addEventListener('mousemove', (e) => {
                    this.mouse.x = e.clientX;
                    this.mouse.y = e.clientY;
                    this.mouse.active = true;
                }, { passive: true });

                window.addEventListener('mouseleave', () => {
                    this.mouse.active = false;
                });
            }

            // Observe theme changes
            const observer = new MutationObserver(() => {
                this.checkTheme();
            });
            observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });

            // Pause when page is hidden
            document.addEventListener('visibilitychange', () => {
                this.isVisible = !document.hidden;
                if (this.isVisible) {
                    this.lastTime = performance.now();
                    this.animate(this.lastTime);
                }
            });
        }

        private animate = (now: number) => {
            if (!this.isVisible) return;

            const delta = Math.min((now - this.lastTime) / 16.66, 2.0);
            this.lastTime = now;

            const w = window.innerWidth;
            const h = window.innerHeight;
            this.ctx.clearRect(0, 0, w, h);

            const timeSec = now * 0.001;
            const maxDist = 130;
            const maxDistSq = maxDist * maxDist;
            const mouseMaxDist = 140;
            const mouseMaxDistSq = mouseMaxDist * mouseMaxDist;

            // 1. Update particle positions
            for (let i = 0; i < this.nodes.length; i++) {
                const node = this.nodes[i];
                const speedSin = Math.sin(now * node.speedRate + node.speedPhase);
                const speedFactor = 0.7 + 0.3 * Math.max(0, speedSin);
                const currentSpeed = node.baseSpeed * speedFactor * delta;

                node.angle += (Math.sin(timeSec * 0.6 + node.curveOffset) * 0.015 + node.angularDrift) * delta;

                // Gentle mouse attraction (desktop only)
                if (this.mouse.active && this.hasPointerFine) {
                    const mdx = this.mouse.x - node.x;
                    const mdy = this.mouse.y - node.y;
                    const mDistSq = mdx * mdx + mdy * mdy;

                    if (mDistSq < mouseMaxDistSq && mDistSq > 15) {
                        const mDist = Math.sqrt(mDistSq);
                        const mAngle = Math.atan2(mdy, mdx);
                        let angleDiff = mAngle - node.angle;
                        while (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
                        while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;

                        const pull = (1 - mDist / mouseMaxDist) * 0.06 * delta;
                        node.angle += angleDiff * pull;
                    }
                }

                node.x += Math.cos(node.angle) * currentSpeed;
                node.y += Math.sin(node.angle) * currentSpeed;
                node.pulsePhase += node.pulseSpeed * delta;

                // Screen boundary wrapping
                const margin = 30;
                if (node.x < -margin) node.x = w + margin;
                else if (node.x > w + margin) node.x = -margin;
                if (node.y < -margin) node.y = h + margin;
                else if (node.y > h + margin) node.y = -margin;
            }

            const n = this.nodes.length;

            // 2. Synaptic Filaments with Batched 2-Pass Stroke (Skipped during active scroll for 120 FPS fluid scrolling)
            if (!this.isScrolling) {
                const baseColor = this.isDark ? '168, 62%, 52%' : '168, 72%, 28%';
                const strongLines: number[] = [];
                const faintLines: number[] = [];

                for (let i = 0; i < n; i++) {
                    const node = this.nodes[i];
                    for (let j = i + 1; j < n; j++) {
                        const other = this.nodes[j];

                        const dx = other.x - node.x;
                        if (dx > maxDist || dx < -maxDist) continue;
                        const dy = other.y - node.y;
                        if (dy > maxDist || dy < -maxDist) continue;

                        const distSq = dx * dx + dy * dy;
                        if (distSq < maxDistSq) {
                            if (distSq < maxDistSq * 0.36) {
                                strongLines.push(node.x, node.y, other.x, other.y);
                            } else {
                                faintLines.push(node.x, node.y, other.x, other.y);
                            }
                        }
                    }
                }

                if (strongLines.length > 0) {
                    this.ctx.beginPath();
                    for (let k = 0; k < strongLines.length; k += 4) {
                        this.ctx.moveTo(strongLines[k], strongLines[k + 1]);
                        this.ctx.lineTo(strongLines[k + 2], strongLines[k + 3]);
                    }
                    this.ctx.strokeStyle = `hsla(${baseColor}, ${this.isDark ? 0.16 : 0.14})`;
                    this.ctx.lineWidth = 1;
                    this.ctx.stroke();
                }

                if (faintLines.length > 0) {
                    this.ctx.beginPath();
                    for (let k = 0; k < faintLines.length; k += 4) {
                        this.ctx.moveTo(faintLines[k], faintLines[k + 1]);
                        this.ctx.lineTo(faintLines[k + 2], faintLines[k + 3]);
                    }
                    this.ctx.strokeStyle = `hsla(${baseColor}, ${this.isDark ? 0.07 : 0.05})`;
                    this.ctx.lineWidth = 1;
                    this.ctx.stroke();
                }
            }

            // 3. Batch-draw colorful nodes (3 fill calls total)
            const sageDots: [number, number, number][] = [];
            const roseDots: [number, number, number][] = [];
            const amberDots: [number, number, number][] = [];

            for (let i = 0; i < n; i++) {
                const node = this.nodes[i];
                const pulse = Math.sin(node.pulsePhase) * 0.45;

                if (node.shapeType === 'flower') {
                    this.drawFlower(this.ctx, node.x, node.y, 6.2 + pulse * 0.5, node.angle, this.isDark);
                } else if (node.shapeType === 'heart') {
                    this.drawHeart(this.ctx, node.x, node.y, 7.0 + pulse * 0.5, node.angle, this.isDark);
                } else if (node.shapeType === 'bear') {
                    this.drawBear(this.ctx, node.x, node.y, 6.0 + pulse * 0.5, node.angle, this.isDark);
                } else {
                    const r = Math.max(1.2, node.radius + pulse);
                    if (node.colorType === 'sage') sageDots.push([node.x, node.y, r]);
                    else if (node.colorType === 'rose') roseDots.push([node.x, node.y, r]);
                    else amberDots.push([node.x, node.y, r]);
                }
            }

            if (sageDots.length > 0) {
                this.ctx.beginPath();
                for (const [x, y, r] of sageDots) {
                    this.ctx.moveTo(x + r, y);
                    this.ctx.arc(x, y, r, 0, Math.PI * 2);
                }
                this.ctx.fillStyle = this.isDark ? 'hsla(168, 65%, 60%, 0.75)' : 'hsla(168, 75%, 32%, 0.70)';
                this.ctx.fill();
            }

            if (roseDots.length > 0) {
                this.ctx.beginPath();
                for (const [x, y, r] of roseDots) {
                    this.ctx.moveTo(x + r, y);
                    this.ctx.arc(x, y, r, 0, Math.PI * 2);
                }
                this.ctx.fillStyle = this.isDark ? 'hsla(348, 80%, 75%, 0.75)' : 'hsla(348, 72%, 48%, 0.70)';
                this.ctx.fill();
            }

            if (amberDots.length > 0) {
                this.ctx.beginPath();
                for (const [x, y, r] of amberDots) {
                    this.ctx.moveTo(x + r, y);
                    this.ctx.arc(x, y, r, 0, Math.PI * 2);
                }
                this.ctx.fillStyle = this.isDark ? 'hsla(42, 95%, 68%, 0.75)' : 'hsla(42, 90%, 42%, 0.75)';
                this.ctx.fill();
            }

            this.animationFrameId = requestAnimationFrame(this.animate);
        };

        private drawFlower(ctx: CanvasRenderingContext2D, x: number, y: number, r: number, angle: number, isDark: boolean) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(angle * 0.4);

            const petalCount = 5;
            const petalDist = r * 0.65;
            const petalRadius = r * 0.52;

            // 5 delicate petals
            ctx.fillStyle = isDark ? 'hsla(348, 85%, 75%, 0.90)' : 'hsla(348, 76%, 58%, 0.85)';
            for (let i = 0; i < petalCount; i++) {
                const theta = (i * Math.PI * 2) / petalCount;
                ctx.beginPath();
                ctx.arc(Math.cos(theta) * petalDist, Math.sin(theta) * petalDist, petalRadius, 0, Math.PI * 2);
                ctx.fill();
            }

            // Warm golden pistil
            ctx.beginPath();
            ctx.arc(0, 0, r * 0.42, 0, Math.PI * 2);
            ctx.fillStyle = isDark ? 'hsla(42, 95%, 68%, 0.95)' : 'hsla(42, 95%, 48%, 0.95)';
            ctx.fill();

            ctx.restore();
        }

        private drawHeart(ctx: CanvasRenderingContext2D, x: number, y: number, s: number, angle: number, isDark: boolean) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(Math.sin(angle) * 0.2);

            const top = -s * 0.35;
            const bottom = s * 0.75;

            ctx.beginPath();
            ctx.moveTo(0, bottom);
            ctx.bezierCurveTo(-s * 1.15, s * 0.1, -s * 1.15, top - s * 0.6, -s * 0.5, top - s * 0.6);
            ctx.bezierCurveTo(-s * 0.12, top - s * 0.6, 0, top - s * 0.2, 0, top);
            ctx.bezierCurveTo(0, top - s * 0.2, s * 0.12, top - s * 0.6, s * 0.5, top - s * 0.6);
            ctx.bezierCurveTo(s * 1.15, top - s * 0.6, s * 1.15, s * 0.1, 0, bottom);
            ctx.closePath();

            ctx.fillStyle = isDark ? 'hsla(348, 85%, 72%, 0.92)' : 'hsla(348, 76%, 48%, 0.88)';
            ctx.fill();

            ctx.restore();
        }

        private drawBear(ctx: CanvasRenderingContext2D, x: number, y: number, r: number, angle: number, isDark: boolean) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(Math.sin(angle * 0.7) * 0.12);

            const headColor = isDark ? 'hsla(38, 82%, 60%, 0.92)' : 'hsla(36, 75%, 44%, 0.88)';
            const earInnerColor = isDark ? 'hsla(348, 75%, 75%, 0.85)' : 'hsla(348, 70%, 65%, 0.85)';
            const snoutColor = isDark ? 'hsla(42, 90%, 82%, 0.95)' : 'hsla(40, 85%, 76%, 0.95)';
            const featureColor = isDark ? 'hsla(224, 28%, 15%, 0.95)' : 'hsla(220, 30%, 15%, 0.95)';

            const earRadius = r * 0.44;
            const earDist = r * 0.76;

            // Two round ears
            ctx.fillStyle = headColor;
            ctx.beginPath();
            ctx.arc(-earDist, -earDist * 0.6, earRadius, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(earDist, -earDist * 0.6, earRadius, 0, Math.PI * 2);
            ctx.fill();

            // Inner ear accents
            ctx.fillStyle = earInnerColor;
            ctx.beginPath();
            ctx.arc(-earDist, -earDist * 0.6, earRadius * 0.52, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(earDist, -earDist * 0.6, earRadius * 0.52, 0, Math.PI * 2);
            ctx.fill();

            // Head
            ctx.fillStyle = headColor;
            ctx.beginPath();
            ctx.arc(0, 0, r, 0, Math.PI * 2);
            ctx.fill();

            // Muzzle / Snout
            ctx.fillStyle = snoutColor;
            ctx.beginPath();
            ctx.arc(0, r * 0.28, r * 0.45, 0, Math.PI * 2);
            ctx.fill();

            // Tiny nose
            ctx.fillStyle = featureColor;
            ctx.beginPath();
            ctx.arc(0, r * 0.16, r * 0.16, 0, Math.PI * 2);
            ctx.fill();

            // Two tiny eyes
            ctx.beginPath();
            ctx.arc(-r * 0.36, -r * 0.12, r * 0.14, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(r * 0.36, -r * 0.12, r * 0.14, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore();
        }
    }

    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
        const canvas = document.getElementById('synapses-canvas') as HTMLCanvasElement;
        if (canvas) {
            new SynapticNetwork(canvas);
        }
    });
</script>

<style>
    .synapses-bg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
        contain: strict;
        transform: translateZ(0);
    }

    #synapses-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        z-index: 2;
    }

    /* Ambient soft background glowing auras (Compositor-thread accelerated, zero main-thread work, zero blur overhead) */
    .ambient-aura {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        will-change: transform;
        transform: translateZ(0);
    }

    .ambient-aura--green {
        top: -12vw;
        left: -12vw;
        width: 65vw;
        height: 65vw;
        max-width: 820px;
        max-height: 820px;
        min-width: 360px;
        min-height: 360px;
        background: radial-gradient(
            circle,
            hsla(168, 68%, 38%, 0.08) 0%,
            hsla(168, 68%, 38%, 0.06) 25%,
            hsla(168, 67%, 40%, 0.035) 45%,
            hsla(168, 65%, 44%, 0.012) 65%,
            transparent 78%
        );
        animation: floatAuraGreen 24s ease-in-out infinite alternate;
    }

    .ambient-aura--rose {
        bottom: -12vw;
        right: -12vw;
        width: 60vw;
        height: 60vw;
        max-width: 780px;
        max-height: 780px;
        min-width: 340px;
        min-height: 340px;
        background: radial-gradient(
            circle,
            hsla(348, 72%, 58%, 0.07) 0%,
            hsla(348, 72%, 58%, 0.05) 25%,
            hsla(348, 70%, 62%, 0.03) 45%,
            hsla(348, 68%, 66%, 0.01) 65%,
            transparent 78%
        );
        animation: floatAuraRose 28s ease-in-out infinite alternate;
    }

    /* Dark Theme Overrides */
    :global([data-theme="dark"]) .ambient-aura--green {
        background: radial-gradient(
            circle,
            hsla(168, 58%, 48%, 0.085) 0%,
            hsla(168, 58%, 48%, 0.06) 25%,
            hsla(168, 58%, 48%, 0.035) 45%,
            hsla(168, 58%, 48%, 0.01) 65%,
            transparent 78%
        );
    }

    :global([data-theme="dark"]) .ambient-aura--rose {
        background: radial-gradient(
            circle,
            hsla(348, 68%, 65%, 0.075) 0%,
            hsla(348, 68%, 65%, 0.05) 25%,
            hsla(348, 68%, 65%, 0.025) 45%,
            hsla(348, 68%, 65%, 0.008) 65%,
            transparent 78%
        );
    }

    @keyframes floatAuraGreen {
        0% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(45px, 30px, 0) scale(1.05); }
        100% { transform: translate3d(-25px, 45px, 0) scale(0.96); }
    }

    @keyframes floatAuraRose {
        0% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(-40px, -30px, 0) scale(1.05); }
        100% { transform: translate3d(30px, -40px, 0) scale(0.96); }
    }
</style>
