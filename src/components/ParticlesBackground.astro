---
// Animated Neural & Synaptic Psychology Background
// Inspiring early childhood neurodevelopment, brain connectivity, and psychological empathy
---

<div class="synapses-bg" id="synapses-bg" aria-hidden="true">
    <canvas id="synapses-canvas"></canvas>
    <div class="ambient-glow ambient-glow--1"></div>
    <div class="ambient-glow ambient-glow--2"></div>
</div>

<script>
    class SynapticNetwork {
        private canvas: HTMLCanvasElement;
        private ctx: CanvasRenderingContext2D;
        private nodes: Array<{
            x: number;
            y: number;
            vx: number;
            vy: number;
            radius: number;
            baseRadius: number;
            colorType: 'sage' | 'rose' | 'amber';
            pulseSpeed: number;
            phase: number;
        }> = [];
        private mouse: { x: number; y: number; active: boolean } = { x: -1000, y: -1000, active: false };
        private animationFrameId: number = 0;
        private isVisible: boolean = true;
        private isDark: boolean = true;

        constructor(canvas: HTMLCanvasElement) {
            this.canvas = canvas;
            this.ctx = canvas.getContext('2d')!;
            this.checkTheme();
            this.resize();
            this.initNodes();
            this.bindEvents();
            this.animate();
        }

        private checkTheme() {
            this.isDark = document.documentElement.getAttribute('data-theme') !== 'light' &&
                          !document.documentElement.classList.contains('light-theme');
        }

        private resize() {
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            this.canvas.width = window.innerWidth * dpr;
            this.canvas.height = window.innerHeight * dpr;
            this.ctx.scale(dpr, dpr);
            this.canvas.style.width = `${window.innerWidth}px`;
            this.canvas.style.height = `${window.innerHeight}px`;
        }

        private initNodes() {
            this.nodes = [];
            // Target around 45 to 65 nodes based on screen width
            const count = Math.min(Math.floor(window.innerWidth / 25), 60);
            const types: ('sage' | 'rose' | 'amber')[] = ['sage', 'sage', 'rose', 'rose', 'amber'];

            for (let i = 0; i < count; i++) {
                const type = types[Math.floor(Math.random() * types.length)];
                const radius = Math.random() * 2.2 + 1.8;
                this.nodes.push({
                    x: Math.random() * window.innerWidth,
                    y: Math.random() * window.innerHeight,
                    vx: (Math.random() - 0.5) * 0.45,
                    vy: (Math.random() - 0.5) * 0.45,
                    radius,
                    baseRadius: radius,
                    colorType: type,
                    pulseSpeed: Math.random() * 0.02 + 0.01,
                    phase: Math.random() * Math.PI * 2,
                });
            }
        }

        private bindEvents() {
            window.addEventListener('resize', () => {
                this.resize();
                this.initNodes();
            }, { passive: true });

            window.addEventListener('mousemove', (e) => {
                this.mouse.x = e.clientX;
                this.mouse.y = e.clientY;
                this.mouse.active = true;
            }, { passive: true });

            window.addEventListener('mouseleave', () => {
                this.mouse.active = false;
            });

            // Observe theme changes
            const observer = new MutationObserver(() => {
                this.checkTheme();
            });
            observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });

            // Pause when page is hidden
            document.addEventListener('visibilitychange', () => {
                this.isVisible = !document.hidden;
                if (this.isVisible) this.animate();
            });
        }

        private animate = () => {
            if (!this.isVisible) return;

            const w = window.innerWidth;
            const h = window.innerHeight;
            this.ctx.clearRect(0, 0, w, h);

            const maxDist = 130;
            const mouseMaxDist = 160;

            // Update & draw nodes
            for (let i = 0; i < this.nodes.length; i++) {
                const node = this.nodes[i];
                node.x += node.vx;
                node.y += node.vy;
                node.phase += node.pulseSpeed;

                // Bounce gently off borders
                if (node.x < 0 || node.x > w) node.vx *= -1;
                if (node.y < 0 || node.y > h) node.vy *= -1;

                // Mouse gentle attraction/interaction
                if (this.mouse.active) {
                    const dx = this.mouse.x - node.x;
                    const dy = this.mouse.y - node.y;
                    const dist = Math.hypot(dx, dy);
                    if (dist < mouseMaxDist && dist > 1) {
                        const force = (mouseMaxDist - dist) / mouseMaxDist * 0.3;
                        node.x += (dx / dist) * force;
                        node.y += (dy / dist) * force;
                    }
                }

                // Node color based on theme
                let color = '';
                const pulse = Math.sin(node.phase) * 0.6;
                const r = Math.max(1, node.baseRadius + pulse);

                if (this.isDark) {
                    if (node.colorType === 'sage') color = `hsla(168, 65%, 58%, ${0.55 + pulse * 0.2})`;
                    else if (node.colorType === 'rose') color = `hsla(348, 80%, 72%, ${0.5 + pulse * 0.2})`;
                    else color = `hsla(42, 90%, 65%, ${0.45 + pulse * 0.2})`;
                } else {
                    if (node.colorType === 'sage') color = `hsla(168, 60%, 40%, ${0.35 + pulse * 0.15})`;
                    else if (node.colorType === 'rose') color = `hsla(348, 65%, 55%, ${0.3 + pulse * 0.15})`;
                    else color = `hsla(42, 80%, 50%, ${0.3 + pulse * 0.15})`;
                }

                this.ctx.beginPath();
                this.ctx.arc(node.x, node.y, r, 0, Math.PI * 2);
                this.ctx.fillStyle = color;
                this.ctx.fill();

                // Connect nearby nodes (Synaptic Filaments)
                for (let j = i + 1; j < this.nodes.length; j++) {
                    const other = this.nodes[j];
                    const dx = other.x - node.x;
                    const dy = other.y - node.y;
                    const dist = Math.hypot(dx, dy);

                    if (dist < maxDist) {
                        const alpha = (1 - dist / maxDist) * (this.isDark ? 0.22 : 0.12);
                        this.ctx.beginPath();
                        this.ctx.moveTo(node.x, node.y);
                        this.ctx.lineTo(other.x, other.y);
                        this.ctx.strokeStyle = this.isDark 
                            ? `hsla(168, 60%, 65%, ${alpha})`
                            : `hsla(168, 55%, 42%, ${alpha})`;
                        this.ctx.lineWidth = 1;
                        this.ctx.stroke();
                    }
                }
            }

            this.animationFrameId = requestAnimationFrame(this.animate);
        };
    }

    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
        const canvas = document.getElementById('synapses-canvas') as HTMLCanvasElement;
        if (canvas) {
            new SynapticNetwork(canvas);
        }
    });
</script>

<style>
    .synapses-bg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
    }

    #synapses-canvas {
        width: 100%;
        height: 100%;
        display: block;
    }

    /* Ambient soothing glowing orbs (Aceternity Aurora / Glow style) */
    .ambient-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.25;
        pointer-events: none;
        transition: opacity var(--transition-slow);
    }

    .ambient-glow--1 {
        top: -10%;
        left: 15%;
        width: 45vw;
        height: 45vw;
        background: radial-gradient(circle, hsla(168, 65%, 48%, 0.4), transparent 70%);
    }

    .ambient-glow--2 {
        bottom: 10%;
        right: 5%;
        width: 40vw;
        height: 40vw;
        background: radial-gradient(circle, hsla(348, 75%, 68%, 0.3), transparent 70%);
    }

    :global(.light-theme) .ambient-glow,
    [data-theme="light"] .ambient-glow {
        opacity: 0.18;
    }
</style>
