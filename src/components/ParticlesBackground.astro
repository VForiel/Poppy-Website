---
// Animated Neural & Synaptic Psychology Background
// High-performance, organic non-linear curved synaptic flow with pulsing saccades
---

<div class="synapses-bg" id="synapses-bg" aria-hidden="true">
    <div class="ambient-glow ambient-glow--1" id="ambient-glow-1"></div>
    <div class="ambient-glow ambient-glow--2" id="ambient-glow-2"></div>
    <canvas id="synapses-canvas"></canvas>
</div>

<script>
    interface SynapticNode {
        x: number;
        y: number;
        baseSpeed: number;
        speedPhase: number;
        speedRate: number;
        angle: number;
        angularDrift: number;
        curveOffset: number;
        radius: number;
        colorType: 'sage' | 'rose' | 'amber';
        pulsePhase: number;
        pulseSpeed: number;
    }

    interface AmbientOrb {
        el: HTMLElement;
        x: number;
        y: number;
        vx: number;
        vy: number;
        radius: number;
        targetSpeed: number;
        phase: number;
    }

    class SynapticNetwork {
        private canvas: HTMLCanvasElement;
        private ctx: CanvasRenderingContext2D;
        private nodes: SynapticNode[] = [];
        private orbs: AmbientOrb[] = [];
        private mouse = { x: -2000, y: -2000, active: false };
        private animationFrameId: number = 0;
        private isVisible: boolean = true;
        private isDark: boolean = false;
        private lastTime: number = 0;

        constructor(canvas: HTMLCanvasElement) {
            this.canvas = canvas;
            this.ctx = canvas.getContext('2d', { alpha: true })!;
            this.checkTheme();
            this.resize();
            this.initNodes();
            this.initOrbs();
            this.bindEvents();
            this.lastTime = performance.now();
            this.animate(this.lastTime);
        }

        private checkTheme() {
            this.isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        }

        private resize() {
            // Cap DPR at 1.25 for crisp rendering with minimal GPU fill overhead
            const dpr = Math.min(window.devicePixelRatio || 1, 1.25);
            const w = window.innerWidth;
            const h = window.innerHeight;
            this.canvas.width = Math.floor(w * dpr);
            this.canvas.height = Math.floor(h * dpr);
            this.ctx.setTransform(1, 0, 0, 1, 0, 0);
            this.ctx.scale(dpr, dpr);
            this.canvas.style.width = `${w}px`;
            this.canvas.style.height = `${h}px`;
        }

        private initOrbs() {
            const el1 = document.getElementById('ambient-glow-1');
            const el2 = document.getElementById('ambient-glow-2');
            if (!el1 || !el2) return;

            const w = window.innerWidth;
            const h = window.innerHeight;
            // Generous radius for high diffusion and seamless edge fade
            const radius1 = Math.max(Math.min(w, h) * 0.48, 360);
            const radius2 = Math.max(Math.min(w, h) * 0.45, 330);

            el1.style.width = `${radius1 * 2}px`;
            el1.style.height = `${radius1 * 2}px`;
            el2.style.width = `${radius2 * 2}px`;
            el2.style.height = `${radius2 * 2}px`;

            if (this.orbs.length === 2) {
                this.orbs[0].radius = radius1;
                this.orbs[0].x = Math.max(radius1 * 0.2, Math.min(w - radius1 * 0.2, this.orbs[0].x));
                this.orbs[0].y = Math.max(radius1 * 0.2, Math.min(h - radius1 * 0.2, this.orbs[0].y));

                this.orbs[1].radius = radius2;
                this.orbs[1].x = Math.max(radius2 * 0.2, Math.min(w - radius2 * 0.2, this.orbs[1].x));
                this.orbs[1].y = Math.max(radius2 * 0.2, Math.min(h - radius2 * 0.2, this.orbs[1].y));
                return;
            }

            // Orb 1: Sage green, starts in top-left region, drifting slowly southeast
            this.orbs.push({
                el: el1,
                x: w * 0.25,
                y: h * 0.28,
                vx: 0.16,
                vy: 0.11,
                radius: radius1,
                targetSpeed: 0.20,
                phase: Math.random() * Math.PI * 2,
            });

            // Orb 2: Rose pink, starts in bottom-right region, drifting slowly northwest
            this.orbs.push({
                el: el2,
                x: w * 0.75,
                y: h * 0.70,
                vx: -0.15,
                vy: -0.13,
                radius: radius2,
                targetSpeed: 0.19,
                phase: Math.random() * Math.PI * 2,
            });

            for (const orb of this.orbs) {
                orb.el.style.transform = `translate3d(${orb.x - orb.radius}px, ${orb.y - orb.radius}px, 0)`;
            }
        }

        private initNodes() {
            this.nodes = [];
            const count = Math.min(Math.floor(window.innerWidth / 35), 40);
            const types: ('sage' | 'rose' | 'amber')[] = ['sage', 'sage', 'rose', 'amber'];

            for (let i = 0; i < count; i++) {
                const type = types[i % types.length];
                const radius = Math.random() * 1.8 + 1.8;
                this.nodes.push({
                    x: Math.random() * window.innerWidth,
                    y: Math.random() * window.innerHeight,
                    baseSpeed: Math.random() * 0.20 + 0.35,
                    speedPhase: Math.random() * Math.PI * 2,
                    speedRate: Math.random() * 0.0012 + 0.0008,
                    angle: Math.random() * Math.PI * 2,
                    angularDrift: (Math.random() - 0.5) * 0.012,
                    curveOffset: Math.random() * 100,
                    radius,
                    colorType: type,
                    pulsePhase: Math.random() * Math.PI * 2,
                    pulseSpeed: Math.random() * 0.02 + 0.01,
                });
            }
        }

        private bindEvents() {
            let resizeTimeout: number;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = window.setTimeout(() => {
                    this.resize();
                    this.initNodes();
                    this.initOrbs();
                }, 150);
            }, { passive: true });

            window.addEventListener('mousemove', (e) => {
                this.mouse.x = e.clientX;
                this.mouse.y = e.clientY;
                this.mouse.active = true;
            }, { passive: true });

            window.addEventListener('mouseleave', () => {
                this.mouse.active = false;
            });

            // Observe theme changes
            const observer = new MutationObserver(() => {
                this.checkTheme();
            });
            observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });

            // Pause when page is hidden
            document.addEventListener('visibilitychange', () => {
                this.isVisible = !document.hidden;
                if (this.isVisible) {
                    this.lastTime = performance.now();
                    this.animate(this.lastTime);
                }
            });
        }

        private animate = (now: number) => {
            if (!this.isVisible) return;

            const delta = Math.min((now - this.lastTime) / 16.66, 2.2);
            this.lastTime = now;

            const w = window.innerWidth;
            const h = window.innerHeight;
            this.ctx.clearRect(0, 0, w, h);

            const timeSec = now * 0.001;

            // 1. Update ambient glow orbs with slow wander and soft cushioned bounce
            for (let i = 0; i < this.orbs.length; i++) {
                const orb = this.orbs[i];

                // Organic gentle directional wander (heading subtle drift)
                const wander = Math.sin(timeSec * 0.20 + orb.phase) * 0.005 * delta;
                const cosW = Math.cos(wander);
                const sinW = Math.sin(wander);
                const nVx = orb.vx * cosW - orb.vy * sinW;
                const nVy = orb.vx * sinW + orb.vy * cosW;
                orb.vx = nVx;
                orb.vy = nVy;

                // Soft cushioned boundary repulsion (decelerates and turns gracefully before hitting edges)
                const cushionX = Math.max(160, w * 0.22);
                const cushionY = Math.max(130, h * 0.22);
                const minX = Math.max(50, orb.radius * 0.18);
                const maxX = w - minX;
                const minY = Math.max(50, orb.radius * 0.18);
                const maxY = h - minY;

                // Left boundary
                if (orb.x < cushionX) {
                    const depth = Math.max(0, (cushionX - orb.x) / (cushionX - minX));
                    orb.vx += depth * 0.016 * delta;
                    if (orb.x < minX && orb.vx < 0) {
                        orb.vx = Math.abs(orb.vx);
                    }
                }
                // Right boundary
                else if (orb.x > w - cushionX) {
                    const depth = Math.max(0, (orb.x - (w - cushionX)) / (cushionX - minX));
                    orb.vx -= depth * 0.016 * delta;
                    if (orb.x > maxX && orb.vx > 0) {
                        orb.vx = -Math.abs(orb.vx);
                    }
                }

                // Top boundary
                if (orb.y < cushionY) {
                    const depth = Math.max(0, (cushionY - orb.y) / (cushionY - minY));
                    orb.vy += depth * 0.016 * delta;
                    if (orb.y < minY && orb.vy < 0) {
                        orb.vy = Math.abs(orb.vy);
                    }
                }
                // Bottom boundary
                else if (orb.y > h - cushionY) {
                    const depth = Math.max(0, (orb.y - (h - cushionY)) / (cushionY - minY));
                    orb.vy -= depth * 0.016 * delta;
                    if (orb.y > maxY && orb.vy > 0) {
                        orb.vy = -Math.abs(orb.vy);
                    }
                }

                // Smooth cruising speed regulation (keeps meditative slow speed without slowing to 0)
                const currentSpeed = Math.hypot(orb.vx, orb.vy);
                if (currentSpeed > 0.001) {
                    const ratio = (orb.targetSpeed / currentSpeed - 1) * 0.04 * delta;
                    orb.vx += orb.vx * ratio;
                    orb.vy += orb.vy * ratio;
                }

                // Update coordinates
                orb.x += orb.vx * delta;
                orb.y += orb.vy * delta;

                // Hardware-accelerated translate3d
                orb.el.style.transform = `translate3d(${orb.x - orb.radius}px, ${orb.y - orb.radius}px, 0)`;
            }

            const maxDist = 115;
            const maxDistSq = maxDist * maxDist;
            const mouseMaxDist = 170;
            const mouseMaxDistSq = mouseMaxDist * mouseMaxDist;

            // 2. Update particle positions with independent, gentle asynchronous drift
            for (let i = 0; i < this.nodes.length; i++) {
                const node = this.nodes[i];

                // Individual gentle organic speed drift (non-synchronized, calm, non-distracting)
                const speedSin = Math.sin(now * node.speedRate + node.speedPhase);
                const speedFactor = 0.65 + 0.35 * Math.max(0, speedSin);
                const currentSpeed = node.baseSpeed * speedFactor * delta;

                // Organic curvature: gentle heading alteration per node
                node.angle += (Math.sin(timeSec * 0.7 + node.curveOffset) * 0.02 + node.angularDrift) * delta;

                // Mouse gravitational attraction
                if (this.mouse.active) {
                    const mdx = this.mouse.x - node.x;
                    const mdy = this.mouse.y - node.y;
                    const mDistSq = mdx * mdx + mdy * mdy;

                    if (mDistSq < mouseMaxDistSq && mDistSq > 10) {
                        const mDist = Math.sqrt(mDistSq);
                        const mAngle = Math.atan2(mdy, mdx);
                        let angleDiff = mAngle - node.angle;
                        while (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
                        while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;

                        const pullIntensity = (1 - mDist / mouseMaxDist) * 0.08 * delta;
                        node.angle += angleDiff * pullIntensity;
                    }
                }

                // Move node with individual speed
                node.x += Math.cos(node.angle) * currentSpeed;
                node.y += Math.sin(node.angle) * currentSpeed;
                node.pulsePhase += node.pulseSpeed * delta;

                // Soft screen boundary wrapping
                const margin = 35;
                if (node.x < -margin) node.x = w + margin;
                else if (node.x > w + margin) node.x = -margin;
                if (node.y < -margin) node.y = h + margin;
                else if (node.y > h + margin) node.y = -margin;
            }

            // 3. High-Performance Batched Synaptic Filaments
            this.ctx.beginPath();
            const n = this.nodes.length;
            for (let i = 0; i < n; i++) {
                const node = this.nodes[i];
                for (let j = i + 1; j < n; j++) {
                    const other = this.nodes[j];

                    // Bounding box early rejection
                    const dx = other.x - node.x;
                    if (dx > maxDist || dx < -maxDist) continue;
                    const dy = other.y - node.y;
                    if (dy > maxDist || dy < -maxDist) continue;

                    const distSq = dx * dx + dy * dy;
                    if (distSq < maxDistSq) {
                        this.ctx.moveTo(node.x, node.y);
                        this.ctx.lineTo(other.x, other.y);
                    }
                }
            }

            this.ctx.lineWidth = 1;
            this.ctx.strokeStyle = this.isDark 
                ? 'hsla(168, 62%, 52%, 0.16)' 
                : 'hsla(168, 70%, 30%, 0.14)';
            this.ctx.stroke();

            // 4. Draw colorful glowing nodes
            for (let i = 0; i < n; i++) {
                const node = this.nodes[i];
                const pulse = Math.sin(node.pulsePhase) * 0.5;
                const r = Math.max(1.2, node.radius + pulse);

                this.ctx.beginPath();
                this.ctx.arc(node.x, node.y, r, 0, Math.PI * 2);

                if (this.isDark) {
                    if (node.colorType === 'sage') this.ctx.fillStyle = 'hsla(168, 65%, 60%, 0.8)';
                    else if (node.colorType === 'rose') this.ctx.fillStyle = 'hsla(348, 80%, 75%, 0.8)';
                    else this.ctx.fillStyle = 'hsla(42, 95%, 68%, 0.8)';
                } else {
                    if (node.colorType === 'sage') this.ctx.fillStyle = 'hsla(168, 75%, 32%, 0.75)';
                    else if (node.colorType === 'rose') this.ctx.fillStyle = 'hsla(348, 72%, 48%, 0.75)';
                    else this.ctx.fillStyle = 'hsla(42, 90%, 42%, 0.8)';
                }

                this.ctx.fill();
            }

            this.animationFrameId = requestAnimationFrame(this.animate);
        };
    }

    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
        const canvas = document.getElementById('synapses-canvas') as HTMLCanvasElement;
        if (canvas) {
            new SynapticNetwork(canvas);
        }
    });
</script>

<style>
    .synapses-bg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
        contain: strict;
        transform: translateZ(0);
    }

    #synapses-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        z-index: 2;
    }

    /* Ambient soft background glowing gradients (Zero-blur GPU optimized) */
    .ambient-glow {
        position: absolute;
        top: 0;
        left: 0;
        border-radius: 50%;
        pointer-events: none;
        z-index: 1;
        will-change: transform;
    }

    /* Light Theme (Default) - visible, delicate, diffuse watercolor aura */
    .ambient-glow--1 {
        background: radial-gradient(
            circle,
            hsla(168, 76%, 42%, 0.28) 0%,
            hsla(168, 74%, 44%, 0.22) 20%,
            hsla(168, 72%, 46%, 0.14) 40%,
            hsla(168, 70%, 48%, 0.07) 62%,
            hsla(168, 68%, 50%, 0.02) 80%,
            transparent 95%
        );
    }

    .ambient-glow--2 {
        background: radial-gradient(
            circle,
            hsla(348, 82%, 62%, 0.26) 0%,
            hsla(348, 80%, 64%, 0.20) 20%,
            hsla(348, 78%, 66%, 0.13) 40%,
            hsla(348, 76%, 68%, 0.065) 62%,
            hsla(348, 74%, 70%, 0.02) 80%,
            transparent 95%
        );
    }

    /* Dark Theme Overrides - rich atmospheric glow on deep dark surface */
    :global([data-theme="dark"]) .ambient-glow--1 {
        background: radial-gradient(
            circle,
            hsla(168, 65%, 48%, 0.25) 0%,
            hsla(168, 65%, 48%, 0.18) 20%,
            hsla(168, 65%, 48%, 0.11) 40%,
            hsla(168, 65%, 48%, 0.05) 62%,
            hsla(168, 65%, 48%, 0.015) 80%,
            transparent 95%
        );
    }

    :global([data-theme="dark"]) .ambient-glow--2 {
        background: radial-gradient(
            circle,
            hsla(348, 75%, 68%, 0.22) 0%,
            hsla(348, 75%, 68%, 0.16) 20%,
            hsla(348, 75%, 68%, 0.10) 40%,
            hsla(348, 75%, 68%, 0.045) 62%,
            hsla(348, 75%, 68%, 0.015) 80%,
            transparent 95%
        );
    }
</style>
