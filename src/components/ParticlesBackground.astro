---
// Animated Neural & Synaptic Psychology Background
// High-performance, organic non-linear curved synaptic flow with pulsing saccades
---

<div class="synapses-bg" id="synapses-bg" aria-hidden="true">
    <div class="ambient-glow ambient-glow--green ambient-glow--g1" id="ambient-glow-g1"></div>
    <div class="ambient-glow ambient-glow--green ambient-glow--g2" id="ambient-glow-g2"></div>
    <div class="ambient-glow ambient-glow--green ambient-glow--g3" id="ambient-glow-g3"></div>
    <div class="ambient-glow ambient-glow--rose ambient-glow--r1" id="ambient-glow-r1"></div>
    <div class="ambient-glow ambient-glow--rose ambient-glow--r2" id="ambient-glow-r2"></div>
    <div class="ambient-glow ambient-glow--rose ambient-glow--r3" id="ambient-glow-r3"></div>
    <canvas id="synapses-canvas"></canvas>
</div>

<script>
    interface SynapticNode {
        x: number;
        y: number;
        baseSpeed: number;
        speedPhase: number;
        speedRate: number;
        angle: number;
        angularDrift: number;
        curveOffset: number;
        radius: number;
        colorType: 'sage' | 'rose' | 'amber';
        shapeType: 'dot' | 'flower' | 'heart' | 'bear';
        pulsePhase: number;
        pulseSpeed: number;
    }

    interface HaloCenterOfGravity {
        x: number;
        y: number;
        vx: number;
        vy: number;
        angle: number;
        angularDrift: number;
        curveOffset: number;
        baseSpeed: number;
        speedRate: number;
        speedPhase: number;
        colorType: 'green' | 'rose';
    }

    interface CompoundHalo {
        el: HTMLElement;
        cgIndex: number; // 0: green, 1: rose
        offsetX: number;
        offsetY: number;
        orbitAngle: number;
        orbitSpeed: number;
        orbitRadius: number;
        orbitEccentricity: number;
        wobblePhase: number;
        radius: number;
        coreRadius: number;
    }

    class SynapticNetwork {
        private canvas: HTMLCanvasElement;
        private ctx: CanvasRenderingContext2D;
        private nodes: SynapticNode[] = [];
        private cgs: HaloCenterOfGravity[] = [];
        private clusterHalos: CompoundHalo[] = [];
        private mouse = { x: -2000, y: -2000, active: false };
        private animationFrameId: number = 0;
        private isVisible: boolean = true;
        private isDark: boolean = false;
        private lastTime: number = 0;

        constructor(canvas: HTMLCanvasElement) {
            this.canvas = canvas;
            this.ctx = canvas.getContext('2d', { alpha: true })!;
            this.checkTheme();
            this.resize();
            this.initNodes();
            this.initOrbs();
            this.bindEvents();
            this.lastTime = performance.now();
            this.animate(this.lastTime);
        }

        private checkTheme() {
            this.isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        }

        private resize() {
            // Cap DPR at 1.25 for crisp rendering with minimal GPU fill overhead
            const dpr = Math.min(window.devicePixelRatio || 1, 1.25);
            const w = window.innerWidth;
            const h = window.innerHeight;
            this.canvas.width = Math.floor(w * dpr);
            this.canvas.height = Math.floor(h * dpr);
            this.ctx.setTransform(1, 0, 0, 1, 0, 0);
            this.ctx.scale(dpr, dpr);
            this.canvas.style.width = `${w}px`;
            this.canvas.style.height = `${h}px`;
        }

        private initOrbs() {
            const gEls = [
                document.getElementById('ambient-glow-g1'),
                document.getElementById('ambient-glow-g2'),
                document.getElementById('ambient-glow-g3'),
            ];
            const rEls = [
                document.getElementById('ambient-glow-r1'),
                document.getElementById('ambient-glow-r2'),
                document.getElementById('ambient-glow-r3'),
            ];

            if (!gEls[0] || !rEls[0]) return;

            const w = window.innerWidth;
            const h = window.innerHeight;

            // Generous outer radius for diffusion + distinct solid core radius
            const outerRadius = Math.max(Math.min(w, h) * 0.46, 340);
            const coreRadius = outerRadius * 0.22; // ~75-85px
            const diameter = outerRadius * 2;

            [...gEls, ...rEls].forEach((el) => {
                if (el) {
                    el.style.width = `${diameter}px`;
                    el.style.height = `${diameter}px`;
                }
            });

            if (this.cgs.length === 2 && this.clusterHalos.length === 6) {
                for (const halo of this.clusterHalos) {
                    halo.radius = outerRadius;
                    halo.coreRadius = coreRadius;
                }
                return;
            }

            // 1. Green Center of Gravity (Top-Left home)
            this.cgs = [
                {
                    x: w * 0.24,
                    y: h * 0.26,
                    vx: 0.12,
                    vy: 0.08,
                    angle: Math.PI * 0.2,
                    angularDrift: (Math.random() - 0.5) * 0.006,
                    curveOffset: Math.random() * 50,
                    baseSpeed: 0.16,
                    speedRate: 0.0008,
                    speedPhase: Math.random() * Math.PI * 2,
                    colorType: 'green',
                },
                // 2. Rose Center of Gravity (Bottom-Right home)
                {
                    x: w * 0.76,
                    y: h * 0.74,
                    vx: -0.11,
                    vy: -0.09,
                    angle: Math.PI * 1.25,
                    angularDrift: (Math.random() - 0.5) * 0.006,
                    curveOffset: Math.random() * 50,
                    baseSpeed: 0.15,
                    speedRate: 0.0007,
                    speedPhase: Math.random() * Math.PI * 2,
                    colorType: 'rose',
                },
            ];

            this.clusterHalos = [];

            // Max offset from CG: coreRadius * 0.45 ensures that for any 2 halos:
            // dist(H1, H2) <= 2 * 0.45 * coreRadius = 0.90 * coreRadius < coreRadius!
            // Thus, every halo's core disk always touches the center of the other halos in its cluster!
            const maxOrb = coreRadius * 0.45;

            // Green Halos (cgIndex: 0)
            const gConfigs = [
                { angle: 0, speed: 0.07, dist: maxOrb * 0.35, ecc: 1.0, phase: 0 },
                { angle: (Math.PI * 2) / 3, speed: -0.055, dist: maxOrb * 0.82, ecc: 1.2, phase: 2.1 },
                { angle: (Math.PI * 4) / 3, speed: 0.05, dist: maxOrb * 0.72, ecc: 0.85, phase: 4.2 },
            ];

            for (let i = 0; i < 3; i++) {
                if (!gEls[i]) continue;
                const cfg = gConfigs[i];
                this.clusterHalos.push({
                    el: gEls[i]!,
                    cgIndex: 0,
                    offsetX: Math.cos(cfg.angle) * cfg.dist,
                    offsetY: Math.sin(cfg.angle) * cfg.dist,
                    orbitAngle: cfg.angle,
                    orbitSpeed: cfg.speed,
                    orbitRadius: cfg.dist,
                    orbitEccentricity: cfg.ecc,
                    wobblePhase: cfg.phase,
                    radius: outerRadius,
                    coreRadius,
                });
            }

            // Rose Halos (cgIndex: 1)
            const rConfigs = [
                { angle: Math.PI * 0.5, speed: -0.065, dist: maxOrb * 0.38, ecc: 1.0, phase: 1.0 },
                { angle: Math.PI * 0.5 + (Math.PI * 2) / 3, speed: 0.055, dist: maxOrb * 0.80, ecc: 1.15, phase: 3.1 },
                { angle: Math.PI * 0.5 + (Math.PI * 4) / 3, speed: -0.045, dist: maxOrb * 0.70, ecc: 0.9, phase: 5.2 },
            ];

            for (let i = 0; i < 3; i++) {
                if (!rEls[i]) continue;
                const cfg = rConfigs[i];
                this.clusterHalos.push({
                    el: rEls[i]!,
                    cgIndex: 1,
                    offsetX: Math.cos(cfg.angle) * cfg.dist,
                    offsetY: Math.sin(cfg.angle) * cfg.dist,
                    orbitAngle: cfg.angle,
                    orbitSpeed: cfg.speed,
                    orbitRadius: cfg.dist,
                    orbitEccentricity: cfg.ecc,
                    wobblePhase: cfg.phase,
                    radius: outerRadius,
                    coreRadius,
                });
            }

            // Initial transforms
            for (const halo of this.clusterHalos) {
                const cg = this.cgs[halo.cgIndex];
                const px = cg.x + halo.offsetX - halo.radius;
                const py = cg.y + halo.offsetY - halo.radius;
                halo.el.style.transform = `translate3d(${px}px, ${py}px, 0)`;
            }
        }

        private initNodes() {
            this.nodes = [];
            const count = Math.min(Math.floor(window.innerWidth / 35), 40);
            const types: ('sage' | 'rose' | 'amber')[] = ['sage', 'sage', 'rose', 'amber'];
            const w = window.innerWidth;
            const h = window.innerHeight;

            for (let i = 0; i < count; i++) {
                const type = types[i % types.length];
                const radius = Math.random() * 1.8 + 1.8;

                // Exactly 1 flower, 1 heart, 1 teddy bear, all other particles remain dots
                let shapeType: 'dot' | 'flower' | 'heart' | 'bear' = 'dot';
                let startX = Math.random() * w;
                let startY = Math.random() * h;

                if (i === 1) {
                    shapeType = 'flower';
                    startX = w * 0.28 + (Math.random() - 0.5) * 150;
                    startY = h * 0.35 + (Math.random() - 0.5) * 120;
                } else if (i === 2) {
                    shapeType = 'heart';
                    startX = w * 0.72 + (Math.random() - 0.5) * 150;
                    startY = h * 0.40 + (Math.random() - 0.5) * 120;
                } else if (i === 3) {
                    shapeType = 'bear';
                    startX = w * 0.50 + (Math.random() - 0.5) * 150;
                    startY = h * 0.72 + (Math.random() - 0.5) * 120;
                }

                this.nodes.push({
                    x: Math.max(20, Math.min(w - 20, startX)),
                    y: Math.max(20, Math.min(h - 20, startY)),
                    baseSpeed: Math.random() * 0.20 + 0.35,
                    speedPhase: Math.random() * Math.PI * 2,
                    speedRate: Math.random() * 0.0012 + 0.0008,
                    angle: Math.random() * Math.PI * 2,
                    angularDrift: (Math.random() - 0.5) * 0.012,
                    curveOffset: Math.random() * 100,
                    radius,
                    colorType: type,
                    shapeType,
                    pulsePhase: Math.random() * Math.PI * 2,
                    pulseSpeed: Math.random() * 0.02 + 0.01,
                });
            }
        }

        private bindEvents() {
            let resizeTimeout: number;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = window.setTimeout(() => {
                    this.resize();
                    this.initNodes();
                    this.initOrbs();
                }, 150);
            }, { passive: true });

            window.addEventListener('mousemove', (e) => {
                this.mouse.x = e.clientX;
                this.mouse.y = e.clientY;
                this.mouse.active = true;
            }, { passive: true });

            window.addEventListener('mouseleave', () => {
                this.mouse.active = false;
            });

            // Observe theme changes
            const observer = new MutationObserver(() => {
                this.checkTheme();
            });
            observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });

            // Pause when page is hidden
            document.addEventListener('visibilitychange', () => {
                this.isVisible = !document.hidden;
                if (this.isVisible) {
                    this.lastTime = performance.now();
                    this.animate(this.lastTime);
                }
            });
        }

        private animate = (now: number) => {
            if (!this.isVisible) return;

            const delta = Math.min((now - this.lastTime) / 16.66, 2.2);
            this.lastTime = now;

            const w = window.innerWidth;
            const h = window.innerHeight;
            this.ctx.clearRect(0, 0, w, h);

            const timeSec = now * 0.001;

            // 1. Update Centers of Gravity (curved trajectories, speed modulation, soft quadrant containment & central overlap)
            for (let c = 0; c < this.cgs.length; c++) {
                const cg = this.cgs[c];

                // Curved trajectory heading drift
                cg.angle += (Math.sin(timeSec * 0.35 + cg.curveOffset) * 0.012 + cg.angularDrift) * delta;

                // Organic speed modulation (deliberately slower than particles)
                const speedSin = Math.sin(now * cg.speedRate + cg.speedPhase);
                const speedFactor = 0.65 + 0.35 * Math.max(0, speedSin);
                const currentSpeed = cg.baseSpeed * speedFactor * delta;

                cg.vx = Math.cos(cg.angle) * currentSpeed;
                cg.vy = Math.sin(cg.angle) * currentSpeed;

                // Soft containment in respective quadrants with central overlap allowed
                if (cg.colorType === 'green') {
                    // Green home is Top-Left: if it ventures into bottom-right past halfway, steer gently back
                    const boundX = w * 0.50;
                    const boundY = h * 0.50;
                    if (cg.x > boundX) {
                        const depth = (cg.x - boundX) / (w * 0.50);
                        cg.vx -= depth * 0.022 * delta;
                    }
                    if (cg.y > boundY) {
                        const depth = (cg.y - boundY) / (h * 0.50);
                        cg.vy -= depth * 0.022 * delta;
                    }
                } else {
                    // Rose home is Bottom-Right: if it ventures into top-left past halfway, steer gently back
                    const boundX = w * 0.50;
                    const boundY = h * 0.50;
                    if (cg.x < boundX) {
                        const depth = (boundX - cg.x) / (w * 0.50);
                        cg.vx += depth * 0.022 * delta;
                    }
                    if (cg.y < boundY) {
                        const depth = (boundY - cg.y) / (h * 0.50);
                        cg.vy += depth * 0.022 * delta;
                    }
                }

                // Viewport edges cushion bounce
                const pad = 85;
                if (cg.x < pad) cg.vx += ((pad - cg.x) / pad) * 0.02 * delta;
                else if (cg.x > w - pad) cg.vx -= ((cg.x - (w - pad)) / pad) * 0.02 * delta;
                if (cg.y < pad) cg.vy += ((pad - cg.y) / pad) * 0.02 * delta;
                else if (cg.y > h - pad) cg.vy -= ((cg.y - (h - pad)) / pad) * 0.02 * delta;

                cg.angle = Math.atan2(cg.vy, cg.vx);
                cg.x += cg.vx;
                cg.y += cg.vy;

                // Screen bounds clamp
                cg.x = Math.max(25, Math.min(w - 25, cg.x));
                cg.y = Math.max(25, Math.min(h - 25, cg.y));
            }

            // Update individual halos relative to their cluster CG
            for (let i = 0; i < this.clusterHalos.length; i++) {
                const halo = this.clusterHalos[i];
                const cg = this.cgs[halo.cgIndex];

                halo.orbitAngle += halo.orbitSpeed * 0.015 * delta;

                const breath = 1 + Math.sin(timeSec * 0.25 + halo.wobblePhase) * 0.15;
                const currentDist = halo.orbitRadius * breath;

                halo.offsetX = Math.cos(halo.orbitAngle) * currentDist * halo.orbitEccentricity;
                halo.offsetY = Math.sin(halo.orbitAngle) * currentDist;

                // Ensure distance constraint: cores always touch center of at least one other halo in cluster
                const maxAllowedDist = halo.coreRadius * 0.46;
                const distFromCG = Math.hypot(halo.offsetX, halo.offsetY);
                if (distFromCG > maxAllowedDist) {
                    const scale = maxAllowedDist / distFromCG;
                    halo.offsetX *= scale;
                    halo.offsetY *= scale;
                }

                const posX = cg.x + halo.offsetX;
                const posY = cg.y + halo.offsetY;

                halo.el.style.transform = `translate3d(${posX - halo.radius}px, ${posY - halo.radius}px, 0)`;
            }

            const maxDist = 140;
            const maxDistSq = maxDist * maxDist;
            const mouseMaxDist = 170;
            const mouseMaxDistSq = mouseMaxDist * mouseMaxDist;

            // 2. Update particle positions with independent, gentle asynchronous drift
            for (let i = 0; i < this.nodes.length; i++) {
                const node = this.nodes[i];

                // Individual gentle organic speed drift (non-synchronized, calm, non-distracting)
                const speedSin = Math.sin(now * node.speedRate + node.speedPhase);
                const speedFactor = 0.65 + 0.35 * Math.max(0, speedSin);
                const currentSpeed = node.baseSpeed * speedFactor * delta;

                // Organic curvature: gentle heading alteration per node
                node.angle += (Math.sin(timeSec * 0.7 + node.curveOffset) * 0.02 + node.angularDrift) * delta;

                // Mouse gravitational attraction
                if (this.mouse.active) {
                    const mdx = this.mouse.x - node.x;
                    const mdy = this.mouse.y - node.y;
                    const mDistSq = mdx * mdx + mdy * mdy;

                    if (mDistSq < mouseMaxDistSq && mDistSq > 10) {
                        const mDist = Math.sqrt(mDistSq);
                        const mAngle = Math.atan2(mdy, mdx);
                        let angleDiff = mAngle - node.angle;
                        while (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
                        while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;

                        const pullIntensity = (1 - mDist / mouseMaxDist) * 0.08 * delta;
                        node.angle += angleDiff * pullIntensity;
                    }
                }

                // Move node with individual speed
                node.x += Math.cos(node.angle) * currentSpeed;
                node.y += Math.sin(node.angle) * currentSpeed;
                node.pulsePhase += node.pulseSpeed * delta;

                // Soft screen boundary wrapping
                const margin = 35;
                if (node.x < -margin) node.x = w + margin;
                else if (node.x > w + margin) node.x = -margin;
                if (node.y < -margin) node.y = h + margin;
                else if (node.y > h + margin) node.y = -margin;
            }

            // 3. Dynamic Synaptic Filaments with Silky Hermite Smoothstep Fade Transition (No connection limits)
            const maxAlpha = this.isDark ? 0.22 : 0.20;
            const baseColor = this.isDark ? '168, 62%, 52%' : '168, 72%, 28%';
            this.ctx.lineWidth = 1;

            const n = this.nodes.length;
            for (let i = 0; i < n; i++) {
                const node = this.nodes[i];
                for (let j = i + 1; j < n; j++) {
                    const other = this.nodes[j];

                    // Bounding box early rejection
                    const dx = other.x - node.x;
                    if (dx > maxDist || dx < -maxDist) continue;
                    const dy = other.y - node.y;
                    if (dy > maxDist || dy < -maxDist) continue;

                    const distSq = dx * dx + dy * dy;
                    if (distSq < maxDistSq) {
                        const dist = Math.sqrt(distSq);
                        // Hermite smoothstep for soft, gradual appearance & fade-out
                        const t = 1 - dist / maxDist;
                        const smooth = t * t * (3 - 2 * t);
                        const alpha = smooth * maxAlpha;

                        if (alpha < 0.006) continue;

                        this.ctx.beginPath();
                        this.ctx.moveTo(node.x, node.y);
                        this.ctx.lineTo(other.x, other.y);
                        this.ctx.strokeStyle = `hsla(${baseColor}, ${alpha.toFixed(3)})`;
                        this.ctx.stroke();
                    }
                }
            }

            // 4. Draw colorful glowing nodes & special custom childhood emblems (flower, heart, bear)
            for (let i = 0; i < n; i++) {
                const node = this.nodes[i];
                const pulse = Math.sin(node.pulsePhase) * 0.5;

                if (node.shapeType === 'flower') {
                    this.drawFlower(this.ctx, node.x, node.y, 6.5 + pulse * 0.6, node.angle, this.isDark);
                } else if (node.shapeType === 'heart') {
                    this.drawHeart(this.ctx, node.x, node.y, 7.2 + pulse * 0.6, node.angle, this.isDark);
                } else if (node.shapeType === 'bear') {
                    this.drawBear(this.ctx, node.x, node.y, 6.2 + pulse * 0.6, node.angle, this.isDark);
                } else {
                    const r = Math.max(1.2, node.radius + pulse);
                    this.ctx.beginPath();
                    this.ctx.arc(node.x, node.y, r, 0, Math.PI * 2);

                    if (this.isDark) {
                        if (node.colorType === 'sage') this.ctx.fillStyle = 'hsla(168, 65%, 60%, 0.8)';
                        else if (node.colorType === 'rose') this.ctx.fillStyle = 'hsla(348, 80%, 75%, 0.8)';
                        else this.ctx.fillStyle = 'hsla(42, 95%, 68%, 0.8)';
                    } else {
                        if (node.colorType === 'sage') this.ctx.fillStyle = 'hsla(168, 75%, 32%, 0.75)';
                        else if (node.colorType === 'rose') this.ctx.fillStyle = 'hsla(348, 72%, 48%, 0.75)';
                        else this.ctx.fillStyle = 'hsla(42, 90%, 42%, 0.8)';
                    }

                    this.ctx.fill();
                }
            }

            this.animationFrameId = requestAnimationFrame(this.animate);
        };

        private drawFlower(ctx: CanvasRenderingContext2D, x: number, y: number, r: number, angle: number, isDark: boolean) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(angle * 0.4);

            const petalCount = 5;
            const petalDist = r * 0.65;
            const petalRadius = r * 0.52;

            // 5 delicate petals
            ctx.fillStyle = isDark ? 'hsla(348, 85%, 75%, 0.90)' : 'hsla(348, 76%, 58%, 0.85)';
            for (let i = 0; i < petalCount; i++) {
                const theta = (i * Math.PI * 2) / petalCount;
                ctx.beginPath();
                ctx.arc(Math.cos(theta) * petalDist, Math.sin(theta) * petalDist, petalRadius, 0, Math.PI * 2);
                ctx.fill();
            }

            // Warm golden pistil
            ctx.beginPath();
            ctx.arc(0, 0, r * 0.42, 0, Math.PI * 2);
            ctx.fillStyle = isDark ? 'hsla(42, 95%, 68%, 0.95)' : 'hsla(42, 95%, 48%, 0.95)';
            ctx.fill();

            ctx.restore();
        }

        private drawHeart(ctx: CanvasRenderingContext2D, x: number, y: number, s: number, angle: number, isDark: boolean) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(Math.sin(angle) * 0.2);

            const top = -s * 0.35;
            const bottom = s * 0.75;

            ctx.beginPath();
            ctx.moveTo(0, bottom);
            // Left lobe
            ctx.bezierCurveTo(-s * 1.15, s * 0.1, -s * 1.15, top - s * 0.6, -s * 0.5, top - s * 0.6);
            ctx.bezierCurveTo(-s * 0.12, top - s * 0.6, 0, top - s * 0.2, 0, top);
            // Right lobe
            ctx.bezierCurveTo(0, top - s * 0.2, s * 0.12, top - s * 0.6, s * 0.5, top - s * 0.6);
            ctx.bezierCurveTo(s * 1.15, top - s * 0.6, s * 1.15, s * 0.1, 0, bottom);
            ctx.closePath();

            ctx.fillStyle = isDark ? 'hsla(348, 85%, 72%, 0.92)' : 'hsla(348, 76%, 48%, 0.88)';
            ctx.fill();

            ctx.restore();
        }

        private drawBear(ctx: CanvasRenderingContext2D, x: number, y: number, r: number, angle: number, isDark: boolean) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(Math.sin(angle * 0.7) * 0.12);

            const headColor = isDark ? 'hsla(38, 82%, 60%, 0.92)' : 'hsla(36, 75%, 44%, 0.88)';
            const earInnerColor = isDark ? 'hsla(348, 75%, 75%, 0.85)' : 'hsla(348, 70%, 65%, 0.85)';
            const snoutColor = isDark ? 'hsla(42, 90%, 82%, 0.95)' : 'hsla(40, 85%, 76%, 0.95)';
            const featureColor = isDark ? 'hsla(224, 28%, 15%, 0.95)' : 'hsla(220, 30%, 15%, 0.95)';

            const earRadius = r * 0.44;
            const earDist = r * 0.76;

            // Two round ears
            ctx.fillStyle = headColor;
            ctx.beginPath();
            ctx.arc(-earDist, -earDist * 0.6, earRadius, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(earDist, -earDist * 0.6, earRadius, 0, Math.PI * 2);
            ctx.fill();

            // Inner ear accents
            ctx.fillStyle = earInnerColor;
            ctx.beginPath();
            ctx.arc(-earDist, -earDist * 0.6, earRadius * 0.52, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(earDist, -earDist * 0.6, earRadius * 0.52, 0, Math.PI * 2);
            ctx.fill();

            // Head
            ctx.fillStyle = headColor;
            ctx.beginPath();
            ctx.arc(0, 0, r, 0, Math.PI * 2);
            ctx.fill();

            // Muzzle / Snout
            ctx.fillStyle = snoutColor;
            ctx.beginPath();
            ctx.arc(0, r * 0.28, r * 0.45, 0, Math.PI * 2);
            ctx.fill();

            // Tiny nose
            ctx.fillStyle = featureColor;
            ctx.beginPath();
            ctx.arc(0, r * 0.16, r * 0.16, 0, Math.PI * 2);
            ctx.fill();

            // Two tiny eyes
            ctx.beginPath();
            ctx.arc(-r * 0.36, -r * 0.12, r * 0.14, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(r * 0.36, -r * 0.12, r * 0.14, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore();
        }
    }

    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
        const canvas = document.getElementById('synapses-canvas') as HTMLCanvasElement;
        if (canvas) {
            new SynapticNetwork(canvas);
        }
    });
</script>

