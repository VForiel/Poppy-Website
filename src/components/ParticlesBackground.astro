---
// Animated Neural & Synaptic Psychology Background
// High-performance, organic non-linear curved synaptic flow with pediatric emblems
// 60/120 FPS buttery smooth scrolling with off-main-thread GPU ambient glows
---

<div class="synapses-bg" id="synapses-bg" aria-hidden="true">
    <div class="ambient-aura ambient-aura--green"></div>
    <div class="ambient-aura ambient-aura--rose"></div>
    <canvas id="synapses-canvas"></canvas>
</div>

<script>
    interface SynapticNode {
        x: number;
        y: number;
        baseSpeed: number;
        speedPhase: number;
        speedRate: number;
        angle: number;
        angularDrift: number;
        curveOffset: number;
        radius: number;
        colorType: 'sage' | 'rose' | 'amber';
        shapeType: 'dot' | 'flower' | 'heart' | 'bear' | 'rainbow' | 'butterfly';
        pulsePhase: number;
        pulseSpeed: number;
    }

    class SynapticNetwork {
        private canvas: HTMLCanvasElement;
        private ctx: CanvasRenderingContext2D;
        private nodes: SynapticNode[] = [];
        private mouse = { x: -2000, y: -2000, active: false };
        private animationFrameId: number = 0;
        private isVisible: boolean = true;
        private isDark: boolean = false;
        private isScrolling: boolean = false;
        private scrollTimeout: number = 0;
        private lastTime: number = 0;
        private hasPointerFine: boolean = true;
        private viewportWidth: number = 0;
        private viewportHeight: number = 0;
        private filamentOpacity: number = 1;
        private lastFilamentCalcTime: number = 0;
        private cachedStrongPairs: [number, number][] = [];
        private cachedFaintPairs: [number, number][] = [];

        constructor(canvas: HTMLCanvasElement) {
            this.canvas = canvas;
            this.ctx = canvas.getContext('2d', { alpha: true })!;
            this.hasPointerFine = window.matchMedia('(pointer: fine)').matches;
            this.checkTheme();
            this.resize(true);
            this.initNodes();
            this.bindEvents();
            this.lastTime = performance.now();
            this.animate(this.lastTime);
        }

        private checkTheme() {
            this.isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        }

        private resize(force: boolean = false): boolean {
            const w = window.innerWidth;
            const h = window.innerHeight;

            // On mobile, scrolling collapses/expands the browser address bar, triggering resize events
            // with zero width change and small height changes (<120px). Reallocating the canvas buffer
            // on those events clears the screen and causes particles to vanish/jump. We ignore them here.
            const widthDiff = Math.abs(w - this.viewportWidth);
            const heightDiff = Math.abs(h - this.viewportHeight);

            if (!force && widthDiff < 25 && heightDiff < 140 && this.viewportWidth > 0) {
                return false;
            }

            const oldW = this.viewportWidth || w;
            const oldH = this.viewportHeight || h;
            this.viewportWidth = w;
            this.viewportHeight = h;

            // Cap DPR at 1 for background canvas: visually indistinguishable for diffuse particles,
            // but saves up to 4x GPU fill-rate on Retina / 4K displays
            const dpr = Math.min(window.devicePixelRatio || 1, 1.25);
            this.canvas.width = Math.floor(w * dpr);
            this.canvas.height = Math.floor(h * dpr);
            this.ctx.setTransform(1, 0, 0, 1, 0, 0);
            this.ctx.scale(dpr, dpr);
            this.canvas.style.width = `${w}px`;
            this.canvas.style.height = `${h}px`;

            // On genuine layout shifts (e.g. orientation rotation), proportionally reposition
            // existing nodes instead of re-randomizing and destroying them!
            if (this.nodes.length > 0 && oldW > 0 && oldH > 0 && (oldW !== w || oldH !== h)) {
                const scaleX = w / oldW;
                const scaleY = h / oldH;
                for (let i = 0; i < this.nodes.length; i++) {
                    this.nodes[i].x = Math.max(10, Math.min(w - 10, this.nodes[i].x * scaleX));
                    this.nodes[i].y = Math.max(10, Math.min(h - 10, this.nodes[i].y * scaleY));
                }
            }

            return true;
        }

        private initNodes() {
            this.nodes = [];
            this.cachedStrongPairs = [];
            this.cachedFaintPairs = [];
            this.lastFilamentCalcTime = 0;
            const isMobile = window.innerWidth < 768;
            // +10 particles: 20 nodes on mobile, up to 30 on desktop
            const count = isMobile ? 20 : Math.min(Math.floor(window.innerWidth / 45), 30);
            const types: ('sage' | 'rose' | 'amber')[] = ['sage', 'sage', 'rose', 'amber'];
            const w = window.innerWidth;
            const h = window.innerHeight;

            for (let i = 0; i < count; i++) {
                const type = types[i % types.length];
                const radius = Math.random() * 1.6 + 1.8;

                // Exactly 1 flower, 1 heart, 1 bear, 1 rainbow, 1 butterfly; all other particles remain dots
                let shapeType: 'dot' | 'flower' | 'heart' | 'bear' | 'rainbow' | 'butterfly' = 'dot';
                let startX = Math.random() * w;
                let startY = Math.random() * h;

                if (i === 1) {
                    shapeType = 'flower';
                    startX = w * 0.20 + (Math.random() - 0.5) * 120;
                    startY = h * 0.32 + (Math.random() - 0.5) * 100;
                } else if (i === 2) {
                    shapeType = 'heart';
                    startX = w * 0.80 + (Math.random() - 0.5) * 120;
                    startY = h * 0.36 + (Math.random() - 0.5) * 100;
                } else if (i === 3) {
                    shapeType = 'bear';
                    startX = w * 0.50 + (Math.random() - 0.5) * 120;
                    startY = h * 0.75 + (Math.random() - 0.5) * 100;
                } else if (i === 4) {
                    shapeType = 'rainbow';
                    startX = w * 0.50 + (Math.random() - 0.5) * 120;
                    startY = h * 0.22 + (Math.random() - 0.5) * 80;
                } else if (i === 5) {
                    shapeType = 'butterfly';
                    startX = w * 0.25 + (Math.random() - 0.5) * 120;
                    startY = h * 0.65 + (Math.random() - 0.5) * 100;
                }

                this.nodes.push({
                    x: Math.max(20, Math.min(w - 20, startX)),
                    y: Math.max(20, Math.min(h - 20, startY)),
                    baseSpeed: Math.random() * 0.18 + 0.25,
                    speedPhase: Math.random() * Math.PI * 2,
                    speedRate: Math.random() * 0.001 + 0.0006,
                    angle: Math.random() * Math.PI * 2,
                    angularDrift: (Math.random() - 0.5) * 0.01,
                    curveOffset: Math.random() * 100,
                    radius,
                    colorType: type,
                    shapeType,
                    pulsePhase: Math.random() * Math.PI * 2,
                    pulseSpeed: Math.random() * 0.02 + 0.01,
                });
            }
        }

        private bindEvents() {
            let resizeTimeout: number;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = window.setTimeout(() => {
                    this.hasPointerFine = window.matchMedia('(pointer: fine)').matches;
                    this.resize();
                }, 150);
            }, { passive: true });

            // Scroll throttle: gracefully ease out filaments during scroll so particles keep drifting smoothly
            // with near-zero CPU/GPU budget and zero navigation lag
            window.addEventListener('scroll', () => {
                this.isScrolling = true;
                clearTimeout(this.scrollTimeout);
                this.scrollTimeout = window.setTimeout(() => {
                    this.isScrolling = false;
                }, 90);
            }, { passive: true });

            if (this.hasPointerFine) {
                window.addEventListener('mousemove', (e) => {
                    this.mouse.x = e.clientX;
                    this.mouse.y = e.clientY;
                    this.mouse.active = true;
                }, { passive: true });

                window.addEventListener('mouseleave', () => {
                    this.mouse.active = false;
                });
            }

            // Observe theme changes
            const observer = new MutationObserver(() => {
                this.checkTheme();
            });
            observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });

            // Pause when page is hidden
            document.addEventListener('visibilitychange', () => {
                this.isVisible = !document.hidden;
                if (this.isVisible) {
                    this.lastTime = performance.now();
                    this.animate(this.lastTime);
                }
            });
        }

        // Throttled synaptic pair finder: runs at 10 Hz with localized spatial grid bucketing
        // Completely avoids pure O(N^2) pairwise comparisons and conserves CPU cycles
        private updateSynapticPairs(now: number, maxDist: number, maxDistSq: number) {
            if (now - this.lastFilamentCalcTime < 100) return;
            this.lastFilamentCalcTime = now;

            const n = this.nodes.length;
            const cellSize = maxDist;
            const strongThreshSq = maxDistSq * 0.36;

            // Spatial Partitioning Grid (O(1) localized bucket lookup)
            const grid = new Map<string, number[]>();
            for (let i = 0; i < n; i++) {
                const node = this.nodes[i];
                const key = `${Math.floor(node.x / cellSize)},${Math.floor(node.y / cellSize)}`;
                const bucket = grid.get(key);
                if (bucket) {
                    bucket.push(i);
                } else {
                    grid.set(key, [i]);
                }
            }

            const strong: [number, number][] = [];
            const faint: [number, number][] = [];

            // Forward neighbor cell offsets: same cell (0,0) + 4 directional neighbors
            const neighborOffsets = [
                [0, 0],
                [1, 0],
                [-1, 1],
                [0, 1],
                [1, 1]
            ];

            for (const [cellKey, members] of grid) {
                const commaIdx = cellKey.indexOf(',');
                const col = parseInt(cellKey.substring(0, commaIdx), 10);
                const row = parseInt(cellKey.substring(commaIdx + 1), 10);
                const memberCount = members.length;

                for (let a = 0; a < memberCount; a++) {
                    const i = members[a];
                    const nodeA = this.nodes[i];

                    // Test within same cell
                    for (let b = a + 1; b < memberCount; b++) {
                        const j = members[b];
                        const nodeB = this.nodes[j];
                        const dx = nodeB.x - nodeA.x;
                        const dy = nodeB.y - nodeA.y;
                        const distSq = dx * dx + dy * dy;
                        if (distSq < maxDistSq) {
                            if (distSq < strongThreshSq) strong.push([i, j]);
                            else faint.push([i, j]);
                        }
                    }

                    // Test in 4 forward neighboring cells
                    for (let o = 1; o < 5; o++) {
                        const neighborKey = `${col + neighborOffsets[o][0]},${row + neighborOffsets[o][1]}`;
                        const neighborBucket = grid.get(neighborKey);
                        if (!neighborBucket) continue;

                        for (let k = 0; k < neighborBucket.length; k++) {
                            const j = neighborBucket[k];
                            const nodeB = this.nodes[j];
                            const dx = nodeB.x - nodeA.x;
                            const dy = nodeB.y - nodeA.y;
                            const distSq = dx * dx + dy * dy;
                            if (distSq < maxDistSq) {
                                if (distSq < strongThreshSq) strong.push([i, j]);
                                else faint.push([i, j]);
                            }
                        }
                    }
                }
            }

            this.cachedStrongPairs = strong;
            this.cachedFaintPairs = faint;
        }

        private animate = (now: number) => {
            if (!this.isVisible) return;

            const delta = Math.min((now - this.lastTime) / 16.66, 2.0);
            this.lastTime = now;

            const w = window.innerWidth;
            const h = window.innerHeight;
            this.ctx.clearRect(0, 0, w, h);

            const timeSec = now * 0.001;
            const maxDist = 130;
            const maxDistSq = maxDist * maxDist;
            const mouseMaxDist = 140;
            const mouseMaxDistSq = mouseMaxDist * mouseMaxDist;

            // 1. Update particle positions (Always keeps moving, even while scrolling!)
            for (let i = 0; i < this.nodes.length; i++) {
                const node = this.nodes[i];
                const speedSin = Math.sin(now * node.speedRate + node.speedPhase);
                const speedFactor = 0.7 + 0.3 * Math.max(0, speedSin);
                const currentSpeed = node.baseSpeed * speedFactor * delta;

                node.angle += (Math.sin(timeSec * 0.6 + node.curveOffset) * 0.015 + node.angularDrift) * delta;

                // Gentle mouse attraction (desktop only, skipped during active scroll for 0-latency scrolling)
                if (!this.isScrolling && this.mouse.active && this.hasPointerFine) {
                    const mdx = this.mouse.x - node.x;
                    const mdy = this.mouse.y - node.y;
                    const mDistSq = mdx * mdx + mdy * mdy;

                    if (mDistSq < mouseMaxDistSq && mDistSq > 15) {
                        const mDist = Math.sqrt(mDistSq);
                        const mAngle = Math.atan2(mdy, mdx);
                        let angleDiff = mAngle - node.angle;
                        while (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
                        while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;

                        const pull = (1 - mDist / mouseMaxDist) * 0.06 * delta;
                        node.angle += angleDiff * pull;
                    }
                }

                node.x += Math.cos(node.angle) * currentSpeed;
                node.y += Math.sin(node.angle) * currentSpeed;
                node.pulsePhase += node.pulseSpeed * delta;

                // Screen boundary wrapping
                const margin = 30;
                if (node.x < -margin) node.x = w + margin;
                else if (node.x > w + margin) node.x = -margin;
                if (node.y < -margin) node.y = h + margin;
                else if (node.y > h + margin) node.y = -margin;
            }

            const n = this.nodes.length;

            // Smoothly ease filament opacity: fades out quickly during active scroll (saving >95% CPU/GPU work),
            // and gently re-appears when stationary.
            if (this.isScrolling) {
                this.filamentOpacity = Math.max(0, this.filamentOpacity - delta * 0.12);
            } else {
                this.filamentOpacity = Math.min(1, this.filamentOpacity + delta * 0.06);
            }

            // 2. Synaptic Filaments: 10 Hz spatial partitioning & cached pair drawing
            if (this.filamentOpacity > 0.03) {
                this.updateSynapticPairs(now, maxDist, maxDistSq);

                const baseColor = this.isDark ? '168, 62%, 52%' : '168, 72%, 28%';

                if (this.cachedStrongPairs.length > 0) {
                    this.ctx.beginPath();
                    for (let k = 0; k < this.cachedStrongPairs.length; k++) {
                        const [i, j] = this.cachedStrongPairs[k];
                        const p1 = this.nodes[i];
                        const p2 = this.nodes[j];
                        if (!p1 || !p2) continue;
                        this.ctx.moveTo(p1.x, p1.y);
                        this.ctx.lineTo(p2.x, p2.y);
                    }
                    const strongAlpha = (this.isDark ? 0.16 : 0.14) * this.filamentOpacity;
                    this.ctx.strokeStyle = `hsla(${baseColor}, ${strongAlpha})`;
                    this.ctx.lineWidth = 1;
                    this.ctx.stroke();
                }

                if (this.cachedFaintPairs.length > 0) {
                    this.ctx.beginPath();
                    for (let k = 0; k < this.cachedFaintPairs.length; k++) {
                        const [i, j] = this.cachedFaintPairs[k];
                        const p1 = this.nodes[i];
                        const p2 = this.nodes[j];
                        if (!p1 || !p2) continue;
                        this.ctx.moveTo(p1.x, p1.y);
                        this.ctx.lineTo(p2.x, p2.y);
                    }
                    const faintAlpha = (this.isDark ? 0.07 : 0.05) * this.filamentOpacity;
                    this.ctx.strokeStyle = `hsla(${baseColor}, ${faintAlpha})`;
                    this.ctx.lineWidth = 1;
                    this.ctx.stroke();
                }
            }

            // 3. Batch-draw colorful nodes (3 fill calls total)
            const sageDots: [number, number, number][] = [];
            const roseDots: [number, number, number][] = [];
            const amberDots: [number, number, number][] = [];

            for (let i = 0; i < n; i++) {
                const node = this.nodes[i];
                const pulse = Math.sin(node.pulsePhase) * 0.45;

                if (node.shapeType === 'flower') {
                    this.drawFlower(this.ctx, node.x, node.y, 6.2 + pulse * 0.5, node.angle, this.isDark);
                } else if (node.shapeType === 'heart') {
                    this.drawHeart(this.ctx, node.x, node.y, 7.0 + pulse * 0.5, node.angle, this.isDark);
                } else if (node.shapeType === 'bear') {
                    this.drawBear(this.ctx, node.x, node.y, 6.0 + pulse * 0.5, node.angle, this.isDark);
                } else if (node.shapeType === 'rainbow') {
                    this.drawRainbow(this.ctx, node.x, node.y, 5.8 + pulse * 0.4, node.angle, this.isDark);
                } else if (node.shapeType === 'butterfly') {
                    this.drawButterfly(this.ctx, node.x, node.y, 6.2 + pulse * 0.4, node.angle, this.isDark);
                } else {
                    const r = Math.max(1.2, node.radius + pulse);
                    if (node.colorType === 'sage') sageDots.push([node.x, node.y, r]);
                    else if (node.colorType === 'rose') roseDots.push([node.x, node.y, r]);
                    else amberDots.push([node.x, node.y, r]);
                }
            }

            if (sageDots.length > 0) {
                this.ctx.beginPath();
                for (const [x, y, r] of sageDots) {
                    this.ctx.moveTo(x + r, y);
                    this.ctx.arc(x, y, r, 0, Math.PI * 2);
                }
                this.ctx.fillStyle = this.isDark ? 'hsla(168, 65%, 60%, 0.75)' : 'hsla(168, 75%, 32%, 0.70)';
                this.ctx.fill();
            }

            if (roseDots.length > 0) {
                this.ctx.beginPath();
                for (const [x, y, r] of roseDots) {
                    this.ctx.moveTo(x + r, y);
                    this.ctx.arc(x, y, r, 0, Math.PI * 2);
                }
                this.ctx.fillStyle = this.isDark ? 'hsla(348, 80%, 75%, 0.75)' : 'hsla(348, 72%, 48%, 0.70)';
                this.ctx.fill();
            }

            if (amberDots.length > 0) {
                this.ctx.beginPath();
                for (const [x, y, r] of amberDots) {
                    this.ctx.moveTo(x + r, y);
                    this.ctx.arc(x, y, r, 0, Math.PI * 2);
                }
                this.ctx.fillStyle = this.isDark ? 'hsla(42, 95%, 68%, 0.75)' : 'hsla(42, 90%, 42%, 0.75)';
                this.ctx.fill();
            }

            this.animationFrameId = requestAnimationFrame(this.animate);
        };

        private drawFlower(ctx: CanvasRenderingContext2D, x: number, y: number, r: number, angle: number, isDark: boolean) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(angle * 0.4);

            const petalCount = 5;
            const petalDist = r * 0.65;
            const petalRadius = r * 0.52;

            // 5 delicate petals
            ctx.fillStyle = isDark ? 'hsla(348, 85%, 75%, 0.90)' : 'hsla(348, 76%, 58%, 0.85)';
            for (let i = 0; i < petalCount; i++) {
                const theta = (i * Math.PI * 2) / petalCount;
                ctx.beginPath();
                ctx.arc(Math.cos(theta) * petalDist, Math.sin(theta) * petalDist, petalRadius, 0, Math.PI * 2);
                ctx.fill();
            }

            // Warm golden pistil
            ctx.beginPath();
            ctx.arc(0, 0, r * 0.42, 0, Math.PI * 2);
            ctx.fillStyle = isDark ? 'hsla(42, 95%, 68%, 0.95)' : 'hsla(42, 95%, 48%, 0.95)';
            ctx.fill();

            ctx.restore();
        }

        private drawHeart(ctx: CanvasRenderingContext2D, x: number, y: number, s: number, angle: number, isDark: boolean) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(Math.sin(angle) * 0.2);

            const top = -s * 0.35;
            const bottom = s * 0.75;

            ctx.beginPath();
            ctx.moveTo(0, bottom);
            ctx.bezierCurveTo(-s * 1.15, s * 0.1, -s * 1.15, top - s * 0.6, -s * 0.5, top - s * 0.6);
            ctx.bezierCurveTo(-s * 0.12, top - s * 0.6, 0, top - s * 0.2, 0, top);
            ctx.bezierCurveTo(0, top - s * 0.2, s * 0.12, top - s * 0.6, s * 0.5, top - s * 0.6);
            ctx.bezierCurveTo(s * 1.15, top - s * 0.6, s * 1.15, s * 0.1, 0, bottom);
            ctx.closePath();

            ctx.fillStyle = isDark ? 'hsla(348, 85%, 72%, 0.92)' : 'hsla(348, 76%, 48%, 0.88)';
            ctx.fill();

            ctx.restore();
        }

        private drawBear(ctx: CanvasRenderingContext2D, x: number, y: number, r: number, angle: number, isDark: boolean) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(Math.sin(angle * 0.7) * 0.12);

            const headColor = isDark ? 'hsla(38, 82%, 60%, 0.92)' : 'hsla(36, 75%, 44%, 0.88)';
            const earInnerColor = isDark ? 'hsla(348, 75%, 75%, 0.85)' : 'hsla(348, 70%, 65%, 0.85)';
            const snoutColor = isDark ? 'hsla(42, 90%, 82%, 0.95)' : 'hsla(40, 85%, 76%, 0.95)';
            const featureColor = isDark ? 'hsla(224, 28%, 15%, 0.95)' : 'hsla(220, 30%, 15%, 0.95)';

            const earRadius = r * 0.44;
            const earDist = r * 0.76;

            // Two round ears
            ctx.fillStyle = headColor;
            ctx.beginPath();
            ctx.arc(-earDist, -earDist * 0.6, earRadius, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(earDist, -earDist * 0.6, earRadius, 0, Math.PI * 2);
            ctx.fill();

            // Inner ear accents
            ctx.fillStyle = earInnerColor;
            ctx.beginPath();
            ctx.arc(-earDist, -earDist * 0.6, earRadius * 0.52, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(earDist, -earDist * 0.6, earRadius * 0.52, 0, Math.PI * 2);
            ctx.fill();

            // Head
            ctx.fillStyle = headColor;
            ctx.beginPath();
            ctx.arc(0, 0, r, 0, Math.PI * 2);
            ctx.fill();

            // Muzzle / Snout
            ctx.fillStyle = snoutColor;
            ctx.beginPath();
            ctx.arc(0, r * 0.28, r * 0.45, 0, Math.PI * 2);
            ctx.fill();

            // Tiny nose
            ctx.fillStyle = featureColor;
            ctx.beginPath();
            ctx.arc(0, r * 0.16, r * 0.16, 0, Math.PI * 2);
            ctx.fill();

            // Two tiny eyes
            ctx.beginPath();
            ctx.arc(-r * 0.36, -r * 0.12, r * 0.14, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(r * 0.36, -r * 0.12, r * 0.14, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore();
        }

        private drawRainbow(ctx: CanvasRenderingContext2D, x: number, y: number, r: number, angle: number, isDark: boolean) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(Math.sin(angle * 0.6) * 0.12);

            // 3 radiant concentric bands matching Philippine's palette: Rose, Amber, Sage Pine
            const colors = isDark
                ? [
                    'hsla(348, 85%, 72%, 0.88)',
                    'hsla(42, 95%, 68%, 0.90)',
                    'hsla(168, 65%, 60%, 0.88)',
                  ]
                : [
                    'hsla(348, 76%, 52%, 0.85)',
                    'hsla(42, 95%, 48%, 0.90)',
                    'hsla(168, 75%, 32%, 0.85)',
                  ];

            const bandWidth = r * 0.32;
            const baseRadius = r * 0.80;

            ctx.lineCap = 'round';
            for (let i = 0; i < 3; i++) {
                ctx.beginPath();
                const currentRadius = baseRadius + (2 - i) * bandWidth;
                ctx.arc(0, r * 0.28, currentRadius, Math.PI, 0, false);
                ctx.strokeStyle = colors[i];
                ctx.lineWidth = bandWidth * 0.92;
                ctx.stroke();
            }

            ctx.restore();
        }

        private drawButterfly(ctx: CanvasRenderingContext2D, x: number, y: number, r: number, angle: number, isDark: boolean) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(angle * 0.35);

            const topColor = isDark ? 'hsla(348, 85%, 74%, 0.88)' : 'hsla(348, 76%, 54%, 0.85)';
            const bottomColor = isDark ? 'hsla(168, 65%, 62%, 0.85)' : 'hsla(168, 72%, 34%, 0.82)';
            const bodyColor = isDark ? 'hsla(220, 20%, 88%, 0.95)' : 'hsla(222, 30%, 20%, 0.95)';

            // Both wings (left and right)
            for (const side of [-1, 1]) {
                ctx.save();
                ctx.scale(side, 1);

                // Forewing (upper petal)
                ctx.beginPath();
                ctx.moveTo(0, -r * 0.1);
                ctx.bezierCurveTo(r * 0.6, -r * 1.1, r * 1.45, -r * 0.85, r * 1.2, -r * 0.1);
                ctx.bezierCurveTo(r * 1.0, r * 0.35, r * 0.4, r * 0.25, 0, 0);
                ctx.fillStyle = topColor;
                ctx.fill();

                // Hindwing (lower petal)
                ctx.beginPath();
                ctx.moveTo(0, 0);
                ctx.bezierCurveTo(r * 0.5, r * 0.2, r * 1.05, r * 0.45, r * 0.8, r * 0.95);
                ctx.bezierCurveTo(r * 0.5, r * 1.15, r * 0.2, r * 0.75, 0, r * 0.25);
                ctx.fillStyle = bottomColor;
                ctx.fill();

                ctx.restore();
            }

            // Slender body
            ctx.beginPath();
            ctx.ellipse(0, 0, r * 0.14, r * 0.55, 0, 0, Math.PI * 2);
            ctx.fillStyle = bodyColor;
            ctx.fill();

            // Head
            ctx.beginPath();
            ctx.arc(0, -r * 0.55, r * 0.16, 0, Math.PI * 2);
            ctx.fillStyle = bodyColor;
            ctx.fill();

            // Antennae
            ctx.strokeStyle = bodyColor;
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(-r * 0.06, -r * 0.65);
            ctx.quadraticCurveTo(-r * 0.30, -r * 1.05, -r * 0.45, -r * 0.98);
            ctx.moveTo(r * 0.06, -r * 0.65);
            ctx.quadraticCurveTo(r * 0.30, -r * 1.05, r * 0.45, -r * 0.98);
            ctx.stroke();

            ctx.restore();
        }
    }

    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
        const canvas = document.getElementById('synapses-canvas') as HTMLCanvasElement;
        if (canvas) {
            new SynapticNetwork(canvas);
        }
    });
</script>

