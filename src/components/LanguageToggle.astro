---
import { toggleLocaleHref } from "../i18n/config";

interface Props {
    currentPath?: string;
    lang?: "fr" | "en";
}

const { currentPath = "/", lang = "fr" } = Astro.props;
const otherLang = lang === "fr" ? "en" : "fr";
const toggleHref = toggleLocaleHref(currentPath, lang);
---

<div class="lang-toggle-wrap">
    <a
        href={toggleHref}
        class="lang-pill"
        title={lang === "fr" ? "Switch to English" : "Passer en Français"}
        aria-label="Changer de langue"
    >
        <span class="lang-globe">🌐</span>
        <span class:list={["lang-label", { active: lang === "fr" }]}>FR</span>
        <span class="lang-divider">/</span>
        <span class:list={["lang-label", { active: lang === "en" }]}>EN</span>
    </a>
</div>

<style>
    .lang-toggle-wrap {
        display: inline-flex;
        align-items: center;
    }

    .lang-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 12px;
        border-radius: var(--radius-full);
        background: var(--color-background-card);
        border: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        font-size: var(--text-xs);
        font-weight: 600;
        text-decoration: none;
        transition: all var(--transition-fast);
    }

    .lang-pill:hover {
        border-color: var(--color-primary);
        color: var(--color-text);
        transform: scale(1.03);
    }

    .lang-globe {
        font-size: 0.9rem;
    }

    .lang-divider {
        opacity: 0.4;
    }

    .lang-label.active {
        color: var(--color-primary);
        font-weight: 700;
    }
</style>
