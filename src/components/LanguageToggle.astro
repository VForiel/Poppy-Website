---
import { toggleLocaleHref } from "../i18n/config";

interface Props {
    currentPath?: string;
    lang?: "fr" | "en";
}

const { currentPath = "/", lang = "fr" } = Astro.props;
const otherLang = lang === "fr" ? "en" : "fr";
const toggleHref = toggleLocaleHref(currentPath, lang);
---

<div class="lang-toggle-wrap">
    <a
        href={toggleHref}
        class="lang-pill"
        title={lang === "fr" ? "Switch to English" : "Passer en Français"}
        aria-label="Changer de langue"
    >
        <span class:list={["lang-label", { active: lang === "fr" }]}>FR</span>
        <span class="lang-divider">/</span>
        <span class:list={["lang-label", { active: lang === "en" }]}>EN</span>
    </a>
</div>

<style>
    .lang-toggle-wrap {
        display: inline-flex;
        align-items: center;
    }

    .lang-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 10px;
        color: var(--color-text-muted);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-decoration: none;
        transition: color var(--transition-fast);
    }

    .lang-pill:hover {
        color: var(--color-text);
    }

    .lang-label {
        position: relative;
        isolation: isolate;
    }

    /* la langue courante est soulignée d'un coup de pinceau */
    .lang-label.active::after {
        content: '';
        position: absolute;
        inset: 45% -4px -2px;
        z-index: -1;
        background-color: color-mix(in srgb, var(--color-petal) 70%, transparent);
        -webkit-mask: var(--paint-stroke) center / 100% 100% no-repeat;
        mask: var(--paint-stroke) center / 100% 100% no-repeat;
    }

    .lang-divider {
        opacity: 0.4;
    }

    .lang-label.active {
        color: var(--color-text);
        font-weight: 700;
    }
</style>
