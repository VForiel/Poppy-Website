---
// Accroche de l'accueil : nom souligné d'une fêlure d'or, et bol peint réparé à l'or (kintsugi)
import HeroBowl from "./HeroBowl.astro";

interface Props {
    lang: "fr" | "en";
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const t = {
    fr: {
        eyebrow: "Psychologie clinique · Petite enfance",
        role: "Doctorante en psychotrauma chez les 3-6 ans",
        primary: "Découvrir mes travaux",
        secondary: "Prendre contact",
    },
    en: {
        eyebrow: "Clinical psychology · Early childhood",
        role: "PhD candidate in psychotrauma in children aged 3 to 6",
        primary: "Explore my work",
        secondary: "Get in touch",
    },
}[lang];

const CRACK = ["M2.0,12.0L22.0,7.5L47.2,10.3L65.9,15.2L90.4,12.2L115.9,11.8L138.4,9.5L167.8,8.8L191.9,12.8L223.1,10.9L242.5,9.5L272.2,12.8L299.1,11.8L320.9,10.3L351.6,7.6L372.7,12.7L398.0,11.0","M90.4,12.2L98.4,6.8L106.4,3.2","M272.2,12.8L282.2,17.6L292.2,20.8"];
---

<div class="home-hero">
    <div class="home-hero__text">
        <p class="home-hero__eyebrow">{t.eyebrow}</p>
        <h1 class="home-hero__name">Philippine Villard</h1>
        <svg class="home-hero__crack" viewBox="0 0 400 24" aria-hidden="true">
            <defs>
                <linearGradient id="home-hero-gold" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0" class="gold-deep" />
                    <stop offset=".45" class="gold" />
                    <stop offset=".6" class="gold-light" />
                    <stop offset="1" class="gold-deep" />
                </linearGradient>
            </defs>
            {CRACK.map((d: string, i: number) => (
                <path d={d} pathLength="1" class:list={["home-hero__seam", { "home-hero__seam--branch": i > 0 }]} />
            ))}
        </svg>
        <p class="home-hero__role">{t.role}</p>
        <div class="home-hero__actions">
            <a href={`${base}${lang}/portfolio`} class="button button--primary">{t.primary}</a>
            <a href={`${base}${lang}/contact`} class="button button--secondary">{t.secondary}</a>
        </div>
    </div>

    <HeroBowl />
</div>

<style>
    .home-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
        align-items: center;
        gap: clamp(2rem, 6vw, 5rem);
        max-width: 1080px;
        margin-inline: auto;
        text-align: left;
    }

    .home-hero__eyebrow {
        margin: 0 0 var(--space-4);
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-text-muted);
    }

    .home-hero__name {
        margin: 0;
        font-size: clamp(2.6rem, 6vw, 4.4rem);
        line-height: 1.05;
    }

    .home-hero__crack {
        display: block;
        width: min(100%, 400px);
        height: auto;
        aspect-ratio: 400 / 24;
        margin-block: var(--space-3) var(--space-4);
        overflow: visible;
    }

    .home-hero__crack .gold-deep { stop-color: color-mix(in srgb, var(--color-amber) 70%, var(--color-ink)); }
    .home-hero__crack .gold { stop-color: var(--color-amber); }
    .home-hero__crack .gold-light { stop-color: color-mix(in srgb, var(--color-amber) 45%, #fff6d8); }

    .home-hero__seam {
        fill: none;
        stroke: url(#home-hero-gold);
        stroke-width: 2.6;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: hero-draw 1.4s 0.4s cubic-bezier(0.5, 0, 0.2, 1) forwards;
    }

    .home-hero__seam--branch {
        stroke-width: 1.6;
        animation-delay: 1.4s;
        animation-duration: 0.6s;
    }

    .home-hero__role {
        margin: 0 0 var(--space-8);
        font-family: var(--font-heading);
        font-size: clamp(var(--text-lg), 2.4vw, var(--text-xl));
        color: var(--color-primary);
        text-wrap: balance;
    }

    .home-hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-5);
    }

    @keyframes hero-draw {
        to { stroke-dashoffset: 0; }
    }

    @media (max-width: 860px) {
        .home-hero {
            grid-template-columns: 1fr;
            justify-items: center;
            text-align: center;
        }

        .home-hero__crack {
            margin-inline: auto;
        }

        .home-hero__actions {
            justify-content: center;
        }

        .home-hero :global(.hero-bowl) {
            justify-self: center;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-hero__seam {
            animation: none;
            stroke-dashoffset: 0;
        }
    }
</style>
