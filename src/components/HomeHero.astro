const CRACK = ["M2.0,12.0L22.0,7.5L47.2,10.3L65.9,15.2L90.4,12.2L115.9,11.8L138.4,9.5L167.8,8.8L191.9,12.8L223.1,10.9L242.5,9.5L272.2,12.8L299.1,11.8L320.9,10.3L351.6,7.6L372.7,12.7L398.0,11.0","M90.4,12.2L98.4,6.8L106.4,3.2","M272.2,12.8L282.2,17.6L292.2,20.8"];
---

<div class="home-hero">
    <div class="home-hero__portrait">
        <span class="home-hero__paint" aria-hidden="true"></span>
        <picture>
            <source srcset={`${base}profile-picture-md.webp`} type="image/webp" />
            <img src={`${base}profile-picture-md.jpg`} width="640" height="640" alt={t.alt} fetchpriority="high" />
        </picture>
        <svg class="home-hero__enso" viewBox="-6 -6 212 212" aria-hidden="true">
            <defs>
                <mask id="home-hero-enso" maskUnits="userSpaceOnUse" x="-10" y="-10" width="220" height="220">
                    <path class="home-hero__enso-reveal" d={ENSO_CENTER} pathLength="1" />
                </mask>
            </defs>
            <path class="home-hero__enso-ink" d={ENSO} mask="url(#home-hero-enso)" />
        </svg>
    </div>

    <div class="home-hero__text">
        <h1 class="home-hero__name">Philippine Villard</h1>
        <svg class="home-hero__crack" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true">
            <defs>
                <linearGradient id="home-hero-gold" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0" class="gold-deep" />
                    <stop offset=".45" class="gold" />
                    <stop offset=".6" class="gold-light" />
                    <stop offset="1" class="gold-deep" />
                </linearGradient>
            </defs>
            {CRACK.map((d: string, i: number) => (
                <path d={d} pathLength="1" class:list={["home-hero__seam", { "home-hero__seam--branch": i > 0 }]} />
            ))}
        </svg>
        <p class="home-hero__role">{t.role}</p>
        <p class="home-hero__lead">{t.lead}</p>
        <div class="home-hero__actions">
            <a href={`${base}${lang}/portfolio`} class="button button--primary">{t.primary}</a>
            <a href={`${base}${lang}/contact`} class="button button--secondary">{t.secondary}</a>
        </div>
    </div>
</div>

<style>
    .home-hero {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: clamp(2rem, 6vw, 5rem);
        max-width: 980px;
        margin-inline: auto;
        text-align: left;
    }

    .home-hero__portrait {
        position: relative;
        width: clamp(210px, 26vw, 330px);
        aspect-ratio: 1;
    }

    /* tache peinte décalée derrière le portrait */
    .home-hero__paint {
        position: absolute;
        inset: -4%;
        background-color: color-mix(in srgb, var(--color-sage) 55%, transparent);
        -webkit-mask: var(--paint-blob) center / 100% 100% no-repeat;
        mask: var(--paint-blob) center / 100% 100% no-repeat;
        transform: translate(7%, 6%) rotate(-10deg);
        animation: hero-paint 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-hero__portrait img {
        position: absolute;
        inset: 9%;
        width: 82%;
        height: 82%;
        border-radius: 50%;
        object-fit: cover;
    }

    .home-hero__enso {
        position: absolute;
        inset: -3%;
        width: 106%;
        height: 106%;
        overflow: visible;
    }

    .home-hero__enso-ink {
        fill: var(--color-ink);
    }

    .home-hero__enso-reveal {
        fill: none;
        stroke: #fff;
        stroke-width: 28;
        stroke-linecap: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: hero-draw 1.6s 0.25s cubic-bezier(0.45, 0.05, 0.25, 1) forwards;
    }

    .home-hero__name {
        margin: 0;
        font-size: clamp(2.6rem, 6vw, 4.4rem);
        line-height: 1.05;
    }

    .home-hero__crack {
        display: block;
        width: min(100%, 400px);
        height: 18px;
        margin-block: var(--space-3) var(--space-4);
        overflow: visible;
    }

    .home-hero__crack .gold-deep { stop-color: color-mix(in srgb, var(--color-amber) 70%, var(--color-ink)); }
    .home-hero__crack .gold { stop-color: var(--color-amber); }
    .home-hero__crack .gold-light { stop-color: color-mix(in srgb, var(--color-amber) 45%, #fff6d8); }

    .home-hero__seam {
        fill: none;
        stroke: url(#home-hero-gold);
        stroke-width: 2.6;
        stroke-linecap: round;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: hero-draw 1.4s 1.2s cubic-bezier(0.5, 0, 0.2, 1) forwards;
    }

    .home-hero__seam--branch {
        stroke-width: 1.6;
        animation-delay: 2.2s;
        animation-duration: 0.6s;
    }

    .home-hero__role {
        margin: 0;
        font-family: var(--font-heading);
        font-size: clamp(var(--text-lg), 2.4vw, var(--text-xl));
        color: var(--color-primary);
        text-wrap: balance;
    }

    .home-hero__lead {
        margin: var(--space-4) 0 var(--space-8);
        max-width: 46ch;
        font-size: var(--text-lg);
    }

    .home-hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-5);
    }

    @keyframes hero-draw {
        to { stroke-dashoffset: 0; }
    }

    @keyframes hero-paint {
        from { transform: translate(0, 0) rotate(-30deg) scale(0.6); opacity: 0; }
    }

    @media (max-width: 760px) {
        .home-hero {
            grid-template-columns: 1fr;
            justify-items: center;
            text-align: center;
        }

        .home-hero__crack {
            margin-inline: auto;
        }

        .home-hero__lead {
            margin-inline: auto;
        }

        .home-hero__actions {
            justify-content: center;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-hero__paint,
        .home-hero__enso-reveal,
        .home-hero__seam {
            animation: none;
            stroke-dashoffset: 0;
        }
    }
</style>
