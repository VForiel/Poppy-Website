---
import Navigation from "./Navigation.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { strings } from "../i18n/strings";
import { withLocalePrefix } from "../i18n/config";

interface Props {
    currentPath?: string;
    lang?: "fr" | "en";
}

const { currentPath, lang = "fr" } = Astro.props;
const tagline = strings[lang].headerTagline;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<header class="header">
    <div class="container">
        <div class="header__content">
            <a href={withLocalePrefix("/", lang)} class="header__logo">
                <div class="avatar-ring">
                    <picture>
                        <source srcset={`${base}profile-picture-sm.webp`} type="image/webp" />
                        <img
                            src={`${base}profile-picture-sm.jpg`}
                            alt="Philippine Villard"
                            class="header__avatar"
                            id="profilePicture"
                            width="44"
                            height="44"
                            loading="eager"
                            fetchpriority="high"
                            decoding="async"
                        />
                    </picture>
                </div>
                <div class="header__text">
                    <span class="header__name">Philippine Villard</span>
                    <span class="header__tagline">{tagline}</span>
                </div>
            </a>

            <!-- Desktop actions -->
            <div class="header__actions">
                <Navigation currentPath={currentPath} lang={lang} isMobile={false} />
                <div class="header__controls">
                    <LanguageToggle currentPath={currentPath} lang={lang} />
                    <ThemeToggle />
                </div>
            </div>

            <!-- Mobile menu button -->
            <button
                class="mobile-menu-btn"
                id="mobileMenuBtn"
                aria-label="Menu de navigation"
                aria-expanded="false"
                aria-controls="mobileMenu"
            >
                <div class="mobile-menu-btn__icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </button>
        </div>
    </div>

    <!-- Mobile Drawer -->
    <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
        <div class="mobile-menu__content">
            <Navigation currentPath={currentPath} lang={lang} isMobile={true} />
            <div class="mobile-menu__footer">
                <div class="mobile-menu__setting">
                    <span class="setting-label">{lang === "fr" ? "Langue" : "Language"}</span>
                    <LanguageToggle currentPath={currentPath} lang={lang} />
                </div>
                <div class="mobile-menu__setting">
                    <span class="setting-label">{lang === "fr" ? "Thème" : "Theme"}</span>
                    <ThemeToggle />
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Lightbox Modal for profile picture -->
<div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox__close" id="lightboxClose" aria-label="Fermer" title="Fermer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>
    <picture>
        <source srcset={`${base}profile-picture.webp`} type="image/webp" />
        <img
            src={`${base}profile-picture.jpg`}
            alt="Philippine Villard"
            class="lightbox__image"
            width="1200"
            height="1200"
            loading="lazy"
            decoding="async"
        />
    </picture>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Mobile menu toggle
        const btn = document.getElementById("mobileMenuBtn");
        const menu = document.getElementById("mobileMenu");

        function closeMenu() {
            if (!btn || !menu) return;
            btn.classList.remove("open");
            menu.classList.remove("open");
            btn.setAttribute("aria-expanded", "false");
            menu.setAttribute("aria-hidden", "true");
            document.body.classList.remove("menu-open");
        }

        function toggleMenu() {
            if (!btn || !menu) return;
            const isOpen = btn.classList.toggle("open");
            menu.classList.toggle("open", isOpen);
            btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
            menu.setAttribute("aria-hidden", isOpen ? "false" : "true");
            document.body.classList.toggle("menu-open", isOpen);
        }

        if (btn && menu) {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                toggleMenu();
            });

            // Close menu on link click
            menu.querySelectorAll("a").forEach((link) => {
                link.addEventListener("click", () => {
                    closeMenu();
                });
            });

            // Close on Escape key
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && menu.classList.contains("open")) {
                    closeMenu();
                }
            });

            // Close when clicking outside of header
            document.addEventListener("click", (e) => {
                if (
                    menu.classList.contains("open") &&
                    !menu.contains(e.target as Node) &&
                    !btn.contains(e.target as Node)
                ) {
                    closeMenu();
                }
            });

            // Close on resize to desktop
            window.addEventListener("resize", () => {
                if (window.innerWidth > 900 && menu.classList.contains("open")) {
                    closeMenu();
                }
            }, { passive: true });
        }

        // Profile Picture Lightbox with Smooth Entrance & Graceful Exit
        const profilePic = document.getElementById("profilePicture");
        const lightbox = document.getElementById("lightbox");
        const closeBtn = document.getElementById("lightboxClose");
        const lightboxImg = lightbox?.querySelector(".lightbox__image");
        let isClosing = false;

        function openLightbox() {
            if (!lightbox || isClosing) return;
            lightbox.classList.remove("is-closing");
            lightbox.classList.add("active");
            lightbox.setAttribute("aria-hidden", "false");
            document.body.classList.add("lightbox-open");
        }

        function closeLightbox() {
            if (!lightbox || isClosing || !lightbox.classList.contains("active")) return;
            isClosing = true;
            lightbox.classList.add("is-closing");
            lightbox.setAttribute("aria-hidden", "true");
            document.body.classList.remove("lightbox-open");

            setTimeout(() => {
                lightbox.classList.remove("active");
                lightbox.classList.remove("is-closing");
                isClosing = false;
            }, 300);
        }

        if (profilePic && lightbox) {
            profilePic.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();
                openLightbox();
            });

            lightbox.addEventListener("click", (e) => {
                if (e.target === lightbox || e.target === closeBtn || closeBtn?.contains(e.target as Node)) {
                    closeLightbox();
                }
            });

            lightboxImg?.addEventListener("click", (e) => {
                e.stopPropagation();
            });

            closeBtn?.addEventListener("click", (e) => {
                e.stopPropagation();
                closeLightbox();
            });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && lightbox.classList.contains("active")) {
                    closeLightbox();
                }
            });
        }
    });
</script>

<style>
    .header {
        position: sticky;
        top: 0;
        /* Fond presque opaque, sans backdrop-filter : le flou de ce qui défile dessous
           était recalculé à chaque image (défilement, pétales) pour un effet imperceptible */
        background-color: color-mix(in srgb, var(--color-background) 96%, transparent);
        border-bottom: 1px solid var(--color-border);
        z-index: 100;
        transition: background-color var(--transition-base), border-color var(--transition-base);
    }

    :global([data-theme="dark"]) .header {
        background-color: color-mix(in srgb, var(--color-background) 95%, transparent);
    }

    .header__content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: var(--space-3);
        gap: var(--space-4);
    }

    .header__logo {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        text-decoration: none;
        min-width: 0;
        flex-shrink: 1;
    }

    .avatar-ring {
        position: relative;
        padding: 2px;
        border-radius: var(--radius-full);
        flex-shrink: 0;
        isolation: isolate;
    }

    /* petite tache peinte décalée derrière l'avatar, comme sur le portrait de l'accueil */
    .avatar-ring::before {
        content: '';
        position: absolute;
        inset: -3px;
        z-index: -1;
        background-color: color-mix(in srgb, var(--color-sage) 65%, transparent);
        -webkit-mask: var(--paint-blob) center / 100% 100% no-repeat;
        mask: var(--paint-blob) center / 100% 100% no-repeat;
        transform: translate(3px, 2px) rotate(-12deg);
    }

    .header__avatar {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-full);
        object-fit: cover;
        cursor: pointer;
        display: block;
        transition: transform var(--transition-fast);
    }

    .header__avatar:hover {
        transform: scale(1.08);
    }

    .header__text {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .header__name {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: var(--text-base);
        color: var(--color-text);
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .header__tagline {
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .header__actions {
        display: flex;
        align-items: center;
        gap: var(--space-6);
    }

    .header__controls {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    /* Mobile Menu Toggle Button (44x44 comfortable touch area) */
    .mobile-menu-btn {
        display: none;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        background: transparent;
        border: 1px solid transparent;
        border-radius: var(--radius-md);
        cursor: pointer;
        padding: 0;
        z-index: 110;
        transition: background-color var(--transition-fast), border-color var(--transition-fast);
        -webkit-tap-highlight-color: transparent;
        flex-shrink: 0;
    }

    .mobile-menu-btn:hover,
    .mobile-menu-btn:focus-visible {
        background: color-mix(in srgb, var(--color-primary) 8%, transparent);
        border-color: var(--color-border);
    }

    .mobile-menu-btn__icon {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 22px;
        height: 16px;
        position: relative;
    }

    .mobile-menu-btn span {
        display: block;
        height: 2px;
        width: 100%;
        background-color: var(--color-text);
        border-radius: 2px;
        transition: transform var(--transition-base), opacity var(--transition-base);
        transform-origin: center;
    }

    .mobile-menu-btn.open span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }
    .mobile-menu-btn.open span:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }
    .mobile-menu-btn.open span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

    /* Mobile Drawer (attached seamlessly below the sticky header) */
    .mobile-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        width: 100%;
        height: calc(100dvh - 100%);
        min-height: calc(100vh - 100%);
        background: color-mix(in srgb, var(--color-background) 98%, transparent);
        border-top: 1px solid var(--color-border);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding: var(--space-6) var(--space-6) var(--space-12);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
        z-index: 105;
        opacity: 0;
        transform: translateY(-8px);
        transition: opacity var(--transition-base), transform var(--transition-base);
    }

    :global([data-theme="dark"]) .mobile-menu {
        background: color-mix(in srgb, var(--color-background) 98%, transparent);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    }

    .mobile-menu.open {
        display: block;
        opacity: 1;
        transform: translateY(0);
    }

    .mobile-menu__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        max-width: 480px;
        margin-inline: auto;
    }

    .mobile-menu__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        padding-top: var(--space-6);
        border-top: 1px solid var(--color-border);
        flex-wrap: wrap;
    }

    .mobile-menu__setting {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }

    .setting-label {
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    @media (max-width: 900px) {
        .header__actions {
            display: none;
        }
        .mobile-menu-btn {
            display: flex;
        }
    }

    /* Lightbox Modal with Smooth Entrance / Graceful Exit Animations */
    .lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.82);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-8);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.32s;
    }

    .lightbox.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .lightbox.active.is-closing {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .lightbox picture {
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 100%;
        max-height: 100%;
    }

    .lightbox__image {
        width: min(85vw, 85vh, 640px);
        height: min(85vw, 85vh, 640px);
        max-width: min(85vw, 85vh, 640px);
        max-height: min(85vw, 85vh, 640px);
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: var(--radius-xl);
        box-shadow: 0 24px 65px rgba(0, 0, 0, 0.65);
        border: 2px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
        transform: scale(0.92) translateY(12px);
        opacity: 0;
        transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: default;
    }

    .lightbox.active .lightbox__image {
        transform: scale(1) translateY(0);
        opacity: 1;
    }

    .lightbox.active.is-closing .lightbox__image {
        transform: scale(0.92) translateY(10px);
        opacity: 0;
        transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .lightbox__close {
        position: absolute;
        top: var(--space-6);
        right: var(--space-6);
        width: 44px;
        height: 44px;
        border-radius: var(--radius-full);
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        opacity: 0;
        transform: scale(0.8);
        transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color var(--transition-fast), border-color var(--transition-fast);
        -webkit-tap-highlight-color: transparent;
    }

    .lightbox.active .lightbox__close {
        opacity: 1;
        transform: scale(1);
    }

    .lightbox.active.is-closing .lightbox__close {
        opacity: 0;
        transform: scale(0.85);
        transition: opacity 0.25s ease-in, transform 0.25s ease-in;
    }

    .lightbox__close:hover,
    .lightbox__close:focus-visible {
        background: rgba(255, 255, 255, 0.28);
        border-color: rgba(255, 255, 255, 0.5);
        transform: scale(1.08) rotate(90deg);
    }

    .lightbox__close svg {
        display: block;
        width: 20px;
        height: 20px;
        stroke: currentColor;
        stroke-width: 2.4;
        stroke-linecap: round;
        stroke-linejoin: round;
        pointer-events: none;
        margin: 0;
    }
</style>
