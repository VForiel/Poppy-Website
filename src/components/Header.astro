---
import Navigation from "./Navigation.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { strings } from "../i18n/strings";
import { withLocalePrefix } from "../i18n/config";

interface Props {
    currentPath?: string;
    lang?: "fr" | "en";
}

const { currentPath, lang = "fr" } = Astro.props;
const tagline = strings[lang].headerTagline;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<header class="header">
    <div class="container">
        <div class="header__content">
            <a href={withLocalePrefix("/", lang)} class="header__logo">
                <div class="avatar-ring">
                    <img
                        src={`${base}profile-picture.jpg`}
                        alt="Philippine Villard"
                        class="header__avatar"
                        id="profilePicture"
                    />
                </div>
                <div class="header__text">
                    <span class="header__name">Philippine Villard</span>
                    <span class="header__tagline">{tagline}</span>
                </div>
            </a>

            <!-- Desktop actions -->
            <div class="header__actions">
                <Navigation currentPath={currentPath} lang={lang} isMobile={false} />
                <div class="header__controls">
                    <LanguageToggle currentPath={currentPath} lang={lang} />
                    <ThemeToggle />
                </div>
            </div>

            <!-- Mobile menu button -->
            <button
                class="mobile-menu-btn"
                id="mobileMenuBtn"
                aria-label="Menu de navigation"
                aria-expanded="false"
                aria-controls="mobileMenu"
            >
                <div class="mobile-menu-btn__icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </button>
        </div>
    </div>

    <!-- Mobile Drawer -->
    <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
        <div class="mobile-menu__content">
            <Navigation currentPath={currentPath} lang={lang} isMobile={true} />
            <div class="mobile-menu__footer">
                <div class="mobile-menu__setting">
                    <span class="setting-label">{lang === "fr" ? "Langue" : "Language"}</span>
                    <LanguageToggle currentPath={currentPath} lang={lang} />
                </div>
                <div class="mobile-menu__setting">
                    <span class="setting-label">{lang === "fr" ? "Thème" : "Theme"}</span>
                    <ThemeToggle />
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Lightbox Modal for profile picture -->
<div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox__close" id="lightboxClose" aria-label="Fermer">&times;</button>
    <img
        src={`${base}profile-picture.jpg`}
        alt="Philippine Villard"
        class="lightbox__image"
    />
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Mobile menu toggle
        const btn = document.getElementById("mobileMenuBtn");
        const menu = document.getElementById("mobileMenu");

        function closeMenu() {
            if (!btn || !menu) return;
            btn.classList.remove("open");
            menu.classList.remove("open");
            btn.setAttribute("aria-expanded", "false");
            menu.setAttribute("aria-hidden", "true");
            document.body.classList.remove("menu-open");
        }

        function toggleMenu() {
            if (!btn || !menu) return;
            const isOpen = btn.classList.toggle("open");
            menu.classList.toggle("open", isOpen);
            btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
            menu.setAttribute("aria-hidden", isOpen ? "false" : "true");
            document.body.classList.toggle("menu-open", isOpen);
        }

        if (btn && menu) {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                toggleMenu();
            });

            // Close menu on link click
            menu.querySelectorAll("a").forEach((link) => {
                link.addEventListener("click", () => {
                    closeMenu();
                });
            });

            // Close on Escape key
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && menu.classList.contains("open")) {
                    closeMenu();
                }
            });

            // Close when clicking outside of header
            document.addEventListener("click", (e) => {
                if (
                    menu.classList.contains("open") &&
                    !menu.contains(e.target as Node) &&
                    !btn.contains(e.target as Node)
                ) {
                    closeMenu();
                }
            });

            // Close on resize to desktop
            window.addEventListener("resize", () => {
                if (window.innerWidth > 900 && menu.classList.contains("open")) {
                    closeMenu();
                }
            }, { passive: true });
        }

        // Profile Picture Lightbox
        const profilePic = document.getElementById("profilePicture");
        const lightbox = document.getElementById("lightbox");
        const closeBtn = document.getElementById("lightboxClose");

        if (profilePic && lightbox) {
            profilePic.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();
                lightbox.classList.add("active");
            });

            lightbox.addEventListener("click", () => {
                lightbox.classList.remove("active");
            });

            closeBtn?.addEventListener("click", () => {
                lightbox.classList.remove("active");
            });
        }
    });
</script>

<style>
    .header {
        position: sticky;
        top: 0;
        background-color: hsla(40, 24%, 98%, 0.94);
        border-bottom: 1px solid var(--color-border);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        z-index: 100;
        transition: background-color var(--transition-base), border-color var(--transition-base);
    }

    :global([data-theme="dark"]) .header {
        background-color: hsla(224, 28%, 9%, 0.92);
    }

    .header__content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: var(--space-3);
        gap: var(--space-4);
    }

    .header__logo {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        text-decoration: none;
        min-width: 0;
        flex-shrink: 1;
    }

    .avatar-ring {
        position: relative;
        padding: 2px;
        border-radius: var(--radius-full);
        background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
        box-shadow: 0 0 14px hsla(168, 62%, 52%, 0.3);
        flex-shrink: 0;
    }

    .header__avatar {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-full);
        object-fit: cover;
        cursor: pointer;
        display: block;
        transition: transform var(--transition-fast);
    }

    .header__avatar:hover {
        transform: scale(1.08);
    }

    .header__text {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .header__name {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: var(--text-base);
        color: var(--color-text);
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .header__tagline {
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .header__actions {
        display: flex;
        align-items: center;
        gap: var(--space-6);
    }

    .header__controls {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    /* Mobile Menu Toggle Button (44x44 comfortable touch area) */
    .mobile-menu-btn {
        display: none;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        background: transparent;
        border: 1px solid transparent;
        border-radius: var(--radius-md);
        cursor: pointer;
        padding: 0;
        z-index: 110;
        transition: background-color var(--transition-fast), border-color var(--transition-fast);
        -webkit-tap-highlight-color: transparent;
        flex-shrink: 0;
    }

    .mobile-menu-btn:hover,
    .mobile-menu-btn:focus-visible {
        background: hsla(168, 62%, 52%, 0.08);
        border-color: var(--color-border);
    }

    .mobile-menu-btn__icon {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 22px;
        height: 16px;
        position: relative;
    }

    .mobile-menu-btn span {
        display: block;
        height: 2px;
        width: 100%;
        background-color: var(--color-text);
        border-radius: 2px;
        transition: transform var(--transition-base), opacity var(--transition-base);
        transform-origin: center;
    }

    .mobile-menu-btn.open span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }
    .mobile-menu-btn.open span:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }
    .mobile-menu-btn.open span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

    /* Mobile Drawer (attached seamlessly below the sticky header) */
    .mobile-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        width: 100%;
        height: calc(100dvh - 100%);
        min-height: calc(100vh - 100%);
        background: hsla(40, 24%, 98%, 0.98);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-top: 1px solid var(--color-border);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding: var(--space-6) var(--space-6) var(--space-12);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
        z-index: 105;
        opacity: 0;
        transform: translateY(-8px);
        transition: opacity var(--transition-base), transform var(--transition-base);
    }

    :global([data-theme="dark"]) .mobile-menu {
        background: hsla(224, 28%, 9%, 0.98);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    }

    .mobile-menu.open {
        display: block;
        opacity: 1;
        transform: translateY(0);
    }

    .mobile-menu__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        max-width: 480px;
        margin-inline: auto;
    }

    .mobile-menu__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        padding-top: var(--space-6);
        border-top: 1px solid var(--color-border);
        flex-wrap: wrap;
    }

    .mobile-menu__setting {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }

    .setting-label {
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    @media (max-width: 900px) {
        .header__actions {
            display: none;
        }
        .mobile-menu-btn {
            display: flex;
        }
    }

    /* Lightbox */
    .lightbox {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(10px);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: var(--space-8);
    }

    .lightbox.active {
        display: flex;
    }

    .lightbox__image {
        max-width: 90vw;
        max-height: 85vh;
        border-radius: var(--radius-xl);
        box-shadow: 0 0 50px rgba(0, 0, 0, 0.6);
        border: 2px solid var(--color-border);
    }

    .lightbox__close {
        position: absolute;
        top: var(--space-6);
        right: var(--space-6);
        background: transparent;
        border: none;
        color: white;
        font-size: 2.5rem;
        cursor: pointer;
        line-height: 1;
    }
</style>
