---
import { strings } from "../i18n/strings";
import { withLocalePrefix } from "../i18n/config";

interface Props {
    lang?: "fr" | "en";
}

const { lang = "fr" } = Astro.props;
const t = strings[lang];
const year = new Date().getFullYear();
---

<footer class="footer">
    <div class="container">
        <div class="footer__grid">
            <div class="footer__about">
                <h3 class="footer__brand">Philippine Villard</h3>
                <p class="footer__tagline">{t.headerTagline}</p>
                <p class="footer__advocacy">« {t.footer.advocacy} »</p>
                <div class="footer__affiliation">
                    <span>🏥 {t.footer.affiliations}</span>
                </div>
            </div>

            <div class="footer__nav">
                <h4 class="footer__heading">{lang === "fr" ? "Navigation" : "Navigation"}</h4>
                <ul class="footer__links">
                    <li><a href={withLocalePrefix("/", lang)}>{t.nav.home}</a></li>
                    <li><a href={withLocalePrefix("/about", lang)}>{t.nav.about}</a></li>
                    <li><a href={withLocalePrefix("/expertise", lang)}>{t.nav.expertise}</a></li>
                    <li><a href={withLocalePrefix("/portfolio", lang)}>{t.nav.portfolio}</a></li>
                    <li><a href={withLocalePrefix("/cv", lang)}>{t.nav.cv}</a></li>
                    <li><a href={withLocalePrefix("/contact", lang)}>{t.nav.contact}</a></li>
                </ul>
            </div>

            <div class="footer__contact">
                <h4 class="footer__heading">{lang === "fr" ? "Contact & Prise de rendez-vous" : "Contact & Inquiries"}</h4>
                <p class="footer__contact-desc">
                    {lang === "fr"
                        ? "Pour des recherches de collaboration, formations ou demandes de bilans :"
                        : "For research collaborations, training requests, or clinical inquiries:"}
                </p>
                <a href="mailto:philippine.villard@hotmail.com" class="footer__email">
                    ✉️ philippine.villard@hotmail.com
                </a>
                <span class="footer__location">📍 Nice, Alpes-Maritimes, France</span>
            </div>
        </div>

        <div class="footer__bottom">
            <p>© {year} Philippine Villard. {t.footer.rights}</p>
            <p class="footer__sub">Fait avec soin & rigueur clinique</p>
        </div>
    </div>
</footer>

<style>
    .footer {
        background: hsla(224, 28%, 8%, 0.95);
        border-top: 1px solid var(--color-border);
        padding-block: var(--space-12) var(--space-8);
        position: relative;
        z-index: 2;
        margin-top: auto;
    }

    :global(.light-theme) .footer,
    [data-theme="light"] .footer {
        background: hsla(40, 20%, 95%, 0.95);
    }

    .footer__grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1.5fr;
        gap: var(--space-10);
        margin-block-end: var(--space-10);
    }

    .footer__brand {
        font-size: var(--text-xl);
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-1);
    }

    .footer__tagline {
        font-size: var(--text-sm);
        color: var(--color-primary);
        font-weight: 600;
        margin-bottom: var(--space-3);
    }

    .footer__advocacy {
        font-size: var(--text-sm);
        font-style: italic;
        color: var(--color-text-secondary);
        margin-bottom: var(--space-4);
        max-width: 40ch;
    }

    .footer__affiliation {
        font-size: var(--text-xs);
        color: var(--color-text-muted);
    }

    .footer__heading {
        font-size: var(--text-sm);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text);
        margin-bottom: var(--space-4);
    }

    .footer__links {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .footer__links a {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        transition: color var(--transition-fast);
    }

    .footer__links a:hover {
        color: var(--color-primary);
    }

    .footer__contact-desc {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        margin-bottom: var(--space-3);
    }

    .footer__email {
        display: inline-block;
        font-size: var(--text-sm);
        color: var(--color-primary);
        font-weight: 600;
        margin-bottom: var(--space-2);
        word-break: break-all;
    }

    .footer__location {
        display: block;
        font-size: var(--text-xs);
        color: var(--color-text-muted);
    }

    .footer__bottom {
        padding-top: var(--space-6);
        border-top: 1px solid var(--color-border-subtle);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-4);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
    }

    @media (max-width: 860px) {
        .footer__grid {
            grid-template-columns: 1fr;
            gap: var(--space-8);
        }
    }
</style>
