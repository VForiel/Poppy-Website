---
// Fond zen : papier washi, halo de soleil, collines au lavis, branche de prunier à l'encre
// et quelques pétales qui tombent (canvas léger, en pause quand l'onglet est caché)
---

<div class="zen-bg" aria-hidden="true">
    <div class="zen-sun"></div>
    <svg class="zen-hills" viewBox="0 0 1200 300" preserveAspectRatio="none">
        <defs>
            <filter id="zen-wash" x="-10%" y="-30%" width="120%" height="160%">
                <feTurbulence type="fractalNoise" baseFrequency=".012 .03" numOctaves="3" seed="8" result="n" />
                <feDisplacementMap in="SourceGraphic" in2="n" scale="28" xChannelSelector="R" yChannelSelector="G" />
                <feGaussianBlur stdDeviation="5" />
            </filter>
        </defs>
        <g filter="url(#zen-wash)">
            <path class="zen-hill zen-hill--far" d="M-60,320 L-60,120 C120,90 240,40 380,70 C520,100 600,150 760,128 C900,108 1000,40 1120,58 C1180,66 1230,90 1260,100 L1260,320Z" />
