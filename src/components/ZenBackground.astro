            <path class="zen-hill zen-hill--near" d="M-60,320 L-60,262 C200,246 360,272 560,258 C760,244 940,236 1260,256 L1260,320Z" />
        </g>
    </svg>
    <svg class="zen-branch" viewBox="0 0 600 380" preserveAspectRatio="xMaxYMin meet">
