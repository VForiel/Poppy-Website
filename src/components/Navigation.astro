---
import { strings } from "../i18n/strings";
import { withLocalePrefix } from "../i18n/config";

interface Props {
  currentPath?: string;
  lang?: 'fr' | 'en';
  isMobile?: boolean;
}

const { currentPath, lang = 'fr', isMobile = false } = Astro.props;
const t = strings[lang].nav;

// On mobile, include Home as the first item so users have an obvious way to navigate back
const navItems = [
  ...(isMobile ? [{ href: withLocalePrefix('/', lang), label: t.home }] : []),
  { href: withLocalePrefix('/about', lang), label: t.about },
  { href: withLocalePrefix('/expertise', lang), label: t.expertise },
  { href: withLocalePrefix('/portfolio', lang), label: t.portfolio },
  { href: withLocalePrefix('/cv', lang), label: t.cv },
  { href: withLocalePrefix('/contact', lang), label: t.contact },
];

const isActiveLink = (href: string) => {
  const normalizedCurrent = (currentPath?.replace(/\/$/, '') || '');
  const normalizedHref = href.replace(/\/$/, '');
  
  if (normalizedHref.endsWith('/fr') || normalizedHref.endsWith('/en')) {
    return normalizedCurrent === normalizedHref || normalizedCurrent === `${normalizedHref}/`;
  }
  return normalizedCurrent.startsWith(normalizedHref);
};
---

<nav class:list={['nav', { 'nav--mobile': isMobile }]} aria-label="Navigation principale">
  <ul class="nav__list">
    {navItems.map((item) => {
      const active = isActiveLink(item.href);
      return (
        <li class="nav__item">
          <a 
            href={item.href} 
            class:list={['nav__link', { 'nav__link--active': active }]}
            aria-current={active ? 'page' : undefined}
          >
            <span class="nav__label">{item.label}</span>
            {isMobile && active && <span class="nav__active-pill" aria-hidden="true">●</span>}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .nav {
    width: 100%;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__item {
    display: inline-flex;
  }

  .nav__link {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    text-decoration: none;
    line-height: 1.3;
  }

  /* trait de pinceau sous le lien : esquissé au survol, plein sur la page courante */
  .nav__link::after {
    content: '';
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    bottom: 1px;
    height: 0.55em;
    z-index: -1;
    background-color: color-mix(in srgb, var(--color-sage) 55%, transparent);
    -webkit-mask: var(--paint-stroke) center / 100% 100% no-repeat;
    mask: var(--paint-stroke) center / 100% 100% no-repeat;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--transition-slow);
  }

  .nav__link:hover {
    color: var(--color-text);
  }

  .nav__link:hover::after {
    transform: scaleX(0.6);
  }

  .nav__link--active {
    color: var(--color-text);
    font-weight: 700;
  }

  .nav__link--active::after,
  .nav__link--active:hover::after {
    transform: scaleX(1);
    background-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
  }

  /* Specific styles for Mobile Drawer navigation */
  .nav--mobile .nav__list {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2);
    width: 100%;
  }

  .nav--mobile .nav__item {
    width: 100%;
    display: block;
  }

  .nav--mobile .nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-base);
    font-weight: 500;
  }

  .nav--mobile .nav__link::after {
    right: auto;
    width: 9em;
  }

  .nav--mobile .nav__link:hover,
  .nav--mobile .nav__link:active {
    color: var(--color-text);
  }

  .nav--mobile .nav__link--active {
    color: var(--color-text);
    font-weight: 700;
  }

  .nav__active-pill {
    font-size: 0.65rem;
    color: var(--color-primary);
    margin-left: var(--space-2);
  }
</style>
