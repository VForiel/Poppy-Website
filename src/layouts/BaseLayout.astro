---
interface Props {
    title: string;
    description?: string;
    lang?: string;
}

const {
    title,
    description = "Philippine Villard - Doctorante en psychologie clinique, spécialisée dans le psychotraumatisme chez les 3 à 6 ans à l'Hôpital Lenval (Nice).",
    lang = "fr",
} = Astro.props;

import "../styles/global.css";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang={lang} data-theme="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />

        <!-- SEO -->
        <title>{title}</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:image" content={`${base}profile-picture.jpg`} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={`${base}profile-picture.jpg`} />

        <!-- Resource Hints & Font Preconnects for Instant Loading -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="image"
            href={`${base}profile-picture-sm.webp`}
            type="image/webp"
        />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700&display=swap"
        />

        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
        <link rel="alternate icon" href={`${base}profile-picture.jpg`} />

        <!-- Prevent theme flash on load (Default is light) -->
        <script is:inline>
            (function () {
                const savedTheme = localStorage.getItem("theme");
                const theme = savedTheme === "dark" ? "dark" : "light";
                document.documentElement.setAttribute("data-theme", theme);
                if (theme === "light") {
                    document.documentElement.classList.add("light-theme");
                } else {
                    document.documentElement.classList.remove("light-theme");
                }
            })();
        </script>
    </head>
    <body>
        <slot />
    </body>
</html>
