---
interface Props {
    title: string;
    description?: string;
    lang?: string;
}

const {
    title,
    description = "Philippine Villard - Doctorante en psychologie clinique, spécialisée dans le psychotraumatisme chez les 3 à 6 ans à l'Hôpital Lenval (Nice).",
    lang = "fr",
} = Astro.props;

// Polices auto-hébergées : aucune requête vers Google Fonts (adresse IP des visiteurs)
// (sous-ensembles latins seulement : les fichiers japonais complets pèsent plusieurs Mo)
import "@fontsource/shippori-mincho/latin-500.css";
import "@fontsource/shippori-mincho/latin-600.css";
import "@fontsource/zen-kaku-gothic-new/latin-400.css";
import "@fontsource/zen-kaku-gothic-new/latin-500.css";
import "@fontsource/zen-kaku-gothic-new/latin-700.css";
// police des grands titres, préchargée pour afficher le nom sans attendre
import headingFont from "@fontsource/shippori-mincho/files/shippori-mincho-latin-600-normal.woff2?url";
import "../styles/global.css";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang={lang} data-theme="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />

        <!-- SEO -->
        <title>{title}</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:image" content={new URL(`${base}profile-picture.jpg`, Astro.site)} />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL(`${base}profile-picture.jpg`, Astro.site)} />

        <!-- Resource Hints -->
        <link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin />
        <link
            rel="preload"
            as="image"
            href={`${base}profile-picture-sm.webp`}
            type="image/webp"
        />

        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
        <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
        <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
        <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
        <link rel="shortcut icon" href={`${base}favicon.ico`} />

        <!-- Prevent theme flash on load (Default is light) -->
        <script is:inline>
            (function () {
                const savedTheme = localStorage.getItem("theme");
                const theme = savedTheme === "dark" ? "dark" : "light";
                document.documentElement.setAttribute("data-theme", theme);
                if (theme === "light") {
                    document.documentElement.classList.add("light-theme");
                } else {
                    document.documentElement.classList.remove("light-theme");
                }
            })();
        </script>
        <script is:inline>
            // Mode allégé pour les machines modestes (GPU intégré + écran très haute densité) :
            // si trop d'images dépassent ~22 ms juste après le chargement, data-perf="low" coupe
            // les effets décoratifs continus. Mémorisé pour la session : les pages suivantes partent allégées.
            (function () {
                var root = document.documentElement;
                try {
                    if (sessionStorage.getItem("perf") === "low") {
                        root.dataset.perf = "low";
                        return;
                    }
                } catch (e) {}
                var last = 0, frames = 0, slow = 0;
                function sample(now) {
                    if (last) {
                        frames++;
                        if (now - last > 22) slow++;
                    }
                    last = now;
                    if (frames < 90) return requestAnimationFrame(sample);
                    if (slow / frames < 0.25) return;
                    root.dataset.perf = "low";
                    try { sessionStorage.setItem("perf", "low"); } catch (e) {}
                    document.dispatchEvent(new Event("perf-low"));
                }
                addEventListener("load", function () {
                    setTimeout(function () { requestAnimationFrame(sample); }, 500);
                });
            })();
        </script>
    </head>
    <body>
        <slot />
    </body>
</html>
