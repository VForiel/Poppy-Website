---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";
import ParticlesBackground from "../components/ParticlesBackground.astro";
import { detectLocaleFromPath } from "../i18n/config";

interface Props {
    title: string;
    description?: string;
    currentPath?: string;
}

const { title, description, currentPath } = Astro.props;
const path = currentPath ?? Astro.url.pathname;
const lang = detectLocaleFromPath(path);
---

<BaseLayout title={title} description={description} lang={lang}>
    <ParticlesBackground />
    <Header currentPath={path} lang={lang} />
    <main class="page-main">
        <slot />
    </main>
    <Banner lang={lang} />
    <Footer lang={lang} />
</BaseLayout>

<style>
    .page-main {
        min-height: calc(100vh - 200px);
        padding-block-start: var(--space-4);
        position: relative;
        z-index: 1;
    }
</style>
