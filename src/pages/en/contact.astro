---
import InkIcon from "../../components/InkIcon.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";

const email = "philippine.villard@hotmail.com";
---

<PageLayout
    title="Contact - Philippine Villard | Clinical Psychologist"
    description="Contact Philippine Villard for post-doctoral inquiries, information on her future private practice in Nice, or specialized early childhood training modules."
    currentPath={Astro.url.pathname}
>
    <Section>
        <div class="contact-header">
            <h1>Contact</h1>
            <p class="lead">
                To discuss a post-doctoral research opportunity, a professional training request, private practice updates in Nice, or collegial clinical exchange.
            </p>
        </div>
    </Section>

    <Section>
        <div class="contact-grid">
            <!-- Main Contact Info & Presets -->
            <div class="contact-main bento-card">
                <h2>Get in Touch</h2>
                <p>
                    Whether you are a fellow psychologist, pediatrician, early childhood professional, judicial magistrate, or academic principal investigator, I welcome your message.
                </p>

                <div class="contact-methods">
                    <div class="contact-method">
                        <div class="contact-method__icon"><InkIcon name="mail" /></div>
                        <div class="contact-method__details">
                            <span class="contact-method__label">Direct Email</span>
                            <a href={`mailto:${email}`} class="contact-method__link">
                                {email}
                            </a>
                        </div>
                    </div>

                    <div class="contact-method">
                        <div class="contact-method__icon"><InkIcon name="pin" /></div>
                        <div class="contact-method__details">
                            <span class="contact-method__label">Primary Location</span>
                            <span class="contact-method__text">
                                Lenval Children's Hospital (CE2P Department), 57 Avenue de la Californie, 06200 Nice, France
                            </span>
                        </div>
                    </div>

                    <div class="contact-method">
                        <div class="contact-method__icon"><InkIcon name="clock" /></div>
                        <div class="contact-method__details">
                            <span class="contact-method__label">Expected Response Time</span>
                            <span class="contact-method__text">
                                Typically within 48 to 72 business hours
                            </span>
                        </div>
                    </div>
                </div>

                <div class="quick-mail-section">
                    <h3>Quick Subject Templates:</h3>
                    <div class="quick-mail-pills">
                        <a
                            href={`mailto:${email}?subject=${encodeURIComponent("[Post-Doc] Research Opportunity / Collaboration")}`}
                            class="button button--secondary mail-pill"
                        >
                            Post-Doc Opportunity
                        </a>
                        <a
                            href={`mailto:${email}?subject=${encodeURIComponent("[Training] Professional Workshop Request")}`}
                            class="button button--secondary mail-pill"
                        >
                            Specialized Training
                        </a>
                        <a
                            href={`mailto:${email}?subject=${encodeURIComponent("[Practice Nice] 2027 Consultation Inquiries")}`}
                            class="button button--secondary mail-pill"
                        >
                            Private Practice (Nice)
                        </a>
                        <a
                            href={`mailto:${email}?subject=${encodeURIComponent("[Exchange] Clinical / Scientific Inquiry")}`}
                            class="button button--secondary mail-pill"
                        >
                            Scientific Inquiry
                        </a>
                    </div>
                </div>
            </div>

            <!-- Sidebar with Opportunities & Status -->
            <aside class="contact-sidebar">
                <div class="bento-card info-card info-card--opportunity">
                    <span class="badge-tag">2027 Opportunities</span>
                    <h3>Research & Post-Doc</h3>
                    <p>
                        Following my doctoral dissertation defense in mid-2027, I am actively seeking a <strong>post-doctoral fellowship</strong> in developmental psychopathology, early psychotrauma assessment, or pediatric neuropsychology (France or internationally).
                    </p>
                </div>

                <div class="bento-card info-card">
                    <h3>Private Clinical Practice</h3>
                    <p>
                        My private clinical practice in Nice is scheduled to launch in <strong>2027</strong>. Preliminary contact for professional network referral and interdisciplinary partnerships is warmly invited.
                    </p>
                </div>

                <div class="bento-card info-card">
                    <h3>Judicial & Child Welfare Seminars</h3>
                    <p>
                        Available for tailored lectures and training modules for juvenile court judges, family court advocates, social services, and maternal-infant protection staff.
                    </p>
                </div>
            </aside>
        </div>
    </Section>
</PageLayout>

<style>
    .contact-header {
        max-width: 75ch;
        margin-inline: auto;
        text-align: center;
        margin-block-end: var(--space-12);
    }

    .contact-header h1 {
        font-size: var(--text-4xl);
        margin-block-end: var(--space-4);
    }

    .lead {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: var(--space-8);
        align-items: start;
    }

    .contact-main {
        padding: var(--space-8);
    }

    .contact-main h2 {
        font-size: var(--text-2xl);
        color: var(--color-text);
        margin-bottom: var(--space-3);
    }

    .contact-main > p {
        color: var(--color-text-secondary);
        line-height: 1.7;
        margin-bottom: var(--space-8);
    }

    .contact-methods {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        margin-bottom: var(--space-8);
        padding-bottom: var(--space-8);
        border-bottom: 1px solid var(--color-border);
    }

    .contact-method {
        display: flex;
        align-items: flex-start;
        gap: var(--space-4);
    }

    .contact-method__icon {
        flex-shrink: 0;
    }

    .contact-method__details {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .contact-method__label {
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.05em;
    }

    .contact-method__link {
        font-size: var(--text-lg);
        font-weight: 600;
        color: var(--color-primary);
        text-decoration: none;
    }

    .contact-method__link:hover {
        text-decoration: underline;
    }

    .contact-method__text {
        font-size: var(--text-base);
        color: var(--color-text);
        line-height: 1.5;
    }

    .quick-mail-section h3 {
        font-size: var(--text-base);
        margin-bottom: var(--space-4);
        color: var(--color-text);
    }

    .quick-mail-pills {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
    }

    .mail-pill {
        font-size: var(--text-sm);
        padding: var(--space-3) var(--space-6);
    }

    .mail-pill:hover {
        color: var(--color-text);
    }

    .contact-sidebar {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .info-card {
        padding: var(--space-6);
    }

    .info-card--opportunity {
        border-color: color-mix(in srgb, var(--color-primary) 40%, transparent);
        background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    }

    .badge-tag {
        display: inline-block;
        font-size: var(--text-xs);
        padding: 3px 10px;
        border-radius: var(--radius-full);
        background: color-mix(in srgb, var(--color-primary) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--color-primary) 22%, transparent);
        color: var(--color-primary-dark);
        font-weight: 700;
        margin-bottom: var(--space-3);
    }

    :global([data-theme="dark"]) .badge-tag {
        background: color-mix(in srgb, var(--color-primary) 12%, transparent);
        border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
        color: var(--color-primary);
    }

    .info-card h3 {
        font-size: var(--text-lg);
        color: var(--color-text);
        margin-bottom: var(--space-2);
    }

    .info-card p {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin: 0;
    }

    @media (max-width: 1024px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }

        .contact-sidebar {
            position: static;
        }
    }
</style>
