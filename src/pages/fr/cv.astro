---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";

const birthDate = new Date("1996-11-22");
const today = new Date();
let age = today.getFullYear() - birthDate.getFullYear();
const m = today.getMonth() - birthDate.getMonth();
if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
    age--;
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<PageLayout
    title="Curriculum Vitae - Philippine Villard | Psychologue & Doctorante"
    description="Curriculum Vitae de Philippine Villard : doctorat en psychologie clinique à l'Hôpital Lenval (CE2P), CPGE Lycée Masséna, expertise psychotraumatisme 3-6 ans."
    currentPath={Astro.url.pathname}
>
    <Section class="cv-section">
        <div class="cv-header bento-card">
            <h1>Philippine Villard</h1>
            <div class="cv-subtitle">
                Doctorante en Psychologie Clinique & Chercheuse en Psychotraumatisme Précoce
            </div>
            <div class="cv-objective">
                <strong>Objectifs 2027 :</strong> Soutenance de thèse (Juin/Juil. 2027) • Installation en cabinet libéral à Nice • Recherche post-doctorale & Formations spécialisées
            </div>
            <div class="cv-contact">
                <span>{age} ans</span>
                <span>•</span>
                <span>Née à Versailles</span>
                <span>•</span>
                <span>philippine.villard@hotmail.com</span>
                <span>•</span>
                <span>Nice, France</span>
            </div>
            <div class="cv-badges">
                <span class="badge-tag">Hôpital Lenval (CE2P)</span>
                <span class="badge-tag">Université Côte d'Azur</span>
                <span class="badge-tag">CPGE Lycée Masséna</span>
                <span class="badge-tag">Anglais C2/C1</span>
            </div>
        </div>

        <div class="cv-content">
            <!-- Formation -->
            <div class="cv-block bento-card">
                <h2 class="cv-block__title">Formation Académique</h2>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Doctorat en Psychologie Clinique & Psychopathologie
                        </h3>
                        <span class="cv-item__date">Fin 2022 — Soutenance Juin/Juil. 2027</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Hôpital pour Enfants Lenval (Service CE2P) & Université Côte d'Azur (UniCA), Nice
                    </div>
                    <p class="cv-item__description">
                        Thèse en 4ème année : <em>Étude comparative de l'efficacité des approches TCC et EMDR dans la prise en charge du psychotraumatisme chez l'enfant de 3 à 6 ans (Hôpital Lenval, service CE2P).</em>
                    </p>
                    <ul class="cv-item__list">
                        <li>Immersion clinique continue au Centre d'Évaluation de l'Enfant et Psychiatrie Périnatale (CE2P).</li>
                        <li>Constitution d'une cohorte clinique d'enfants d'âge préscolaire exposés à des traumatismes aigus et complexes.</li>
                        <li>Développement de grilles d'observation des marqueurs non-verbaux (jeux répétitifs, dissociation, insécurité posturale).</li>
                    </ul>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Master en Psychologie Clinique & Psychopathologie
                        </h3>
                        <span class="cv-item__date">2020 — 2022</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Université Côte d'Azur (UniCA), Nice
                    </div>
                    <p class="cv-item__description">
                        Spécialisation clinique de l'enfant et de l'adolescent, théories de l'attachement, psychopathologie périnatale et méthodologie de la recherche clinique.
                    </p>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Licence de Psychologie
                        </h3>
                        <span class="cv-item__date">2018 — 2020</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Université Côte d'Azur (UniCA), Nice
                    </div>
                    <p class="cv-item__description">
                        Psychologie du développement, neuropsychologie cognitive, psychologie sociale et méthodes quantitatives/qualitatives.
                    </p>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Classe Préparatoire Littéraire (CPGE) — Option Psychologie
                        </h3>
                        <span class="cv-item__date">2015 — 2018</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Lycée Masséna, Nice
                    </div>
                    <p class="cv-item__description">
                        Formation d'excellence en humanités, philosophie morale, langues vivantes et sciences humaines. Solide socle de rigueur intellectuelle, d'analyse critique des textes et d'éthique clinique.
                    </p>
                </div>
            </div>

            <!-- Expérience Clinique -->
            <div class="cv-block bento-card">
                <h2 class="cv-block__title">Expérience Clinique & Hospitalière</h2>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Psychologue Chercheuse — Consultation Spécialisée Psychotrauma
                        </h3>
                        <span class="cv-item__date">Fin 2022 — Présent</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Hôpital Lenval, Service CE2P (Centre d'Évaluation de l'Enfant et Psychiatrie Périnatale), Nice
                    </div>
                    <p class="cv-item__description">
                        Prise en charge et évaluation diagnostique d'enfants de 3 à 6 ans victimes ou témoins de violences intrafamiliales, négligences graves ou traumatismes accidentels.
                    </p>
                    <ul class="cv-item__list">
                        <li>Passation de bilans psychologiques et développementaux outillés.</li>
                        <li>Séances de médiation thérapeutique par le jeu symbolique et le dessin.</li>
                        <li>Guidance parentale et entretiens de soutien au lien d'attachement précoce.</li>
                        <li>Participation aux réunions de synthèse pluridisciplinaires (pédopsychiatres, pédiatres, juristes, services sociaux).</li>
                    </ul>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Pratique Clinique en Stages Hospitaliers & Médico-Sociaux
                        </h3>
                        <span class="cv-item__date">2020 — 2022</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Centres Médico-Psychologiques (CMP enfants) & Services Pédiatriques, Nice
                    </div>
                    <p class="cv-item__description">
                        Accompagnement d'enfants d'âge préscolaire et scolaire, passation de tests psychométriques et animation d'ateliers thérapeutiques à médiation.
                    </p>
                </div>
            </div>

            <!-- Compétences & Outils -->
            <div class="cv-block bento-card">
                <h2 class="cv-block__title">Outils Cliniques & Compétences</h2>

                <div class="cv-skills">
                    <div class="cv-skill-group">
                        <h3>Évaluation du Trauma Précoce</h3>
                        <p>
                            Grille d'indicateurs non-verbaux formels, protocoles d'observation standardisée des 3–6 ans, TESI (Traumatic Events Screening), repérage de la dissociation péritraumatique.
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Tests & Échelles Psychométriques</h3>
                        <p>
                            WPPSI-IV (échelles d'intelligence préscolaire), WISC-V, Vineland-II (comportement adaptatif), tests projectifs (Patte-Noire, Scéno-Test, Test du dessin).
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Médiations Thérapeutiques</h3>
                        <p>
                            Approches TCC adaptées au jeune enfant, EMDR pédiatrique (stimulations bilatérales alternées et métaphores), thérapie par le jeu symbolique (Play Therapy), stabilisation émotionnelle et soutien au lien d'attachement primaire.
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Langues de Travail</h3>
                        <p>
                            <strong>Français :</strong> Langue maternelle (courant, rédactionnel soutenu)<br />
                            <strong>Anglais :</strong> Niveau C2 / C1 (bilingue professionnel et scientifique, participation à colloques internationaux)
                        </p>
                    </div>
                </div>
            </div>

            <!-- Plaidoyer, Publications & Livres -->
            <div class="cv-block bento-card">
                <h2 class="cv-block__title">Plaidoyer, Recherche & Publications</h2>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Sensibilisation de l'Institution Judiciaire & Protection de l'Enfance
                        </h3>
                    </div>
                    <p class="cv-item__description">
                        Défense d'une prise en compte accrue des marqueurs corporels et comportementaux chez les enfants sans accès à une parole construite, dans le cadre des signalements et décisions de justice.
                    </p>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Travaux Scientifiques & Projets d'Écriture
                        </h3>
                    </div>
                    <ul class="cv-item__list">
                        <li>Articles de recherche en cours de rédaction sur la sensibilité diagnostique des jeux post-traumatiques figés chez les 3–6 ans.</li>
                        <li>Projets d'ouvrages et de guides cliniques de référence sur la traumatologie préscolaire destinés aux soignants et intervenants de l'enfance.</li>
                    </ul>
                </div>
            </div>

            <!-- Qualités Personnelles -->
            <div class="cv-block bento-card">
                <h2 class="cv-block__title">Qualités & Posture Clinique</h2>
                <div class="cv-qualities">
                    <span class="cv-quality">Rigueur diagnostique</span>
                    <span class="cv-quality">Empathie & Bienveillance</span>
                    <span class="cv-quality">Sensibilité à l'enfance</span>
                    <span class="cv-quality">Engagement déontologique</span>
                    <span class="cv-quality">Aisance relationnelle & pluridisciplinaire</span>
                    <span class="cv-quality">Pédagogie</span>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="cv-footer">
                <a href={`${base}fr/contact`} class="button button--primary">
                    Me contacter
                </a>
                <button onclick="window.print()" class="button button--secondary">
                    🖨️ Imprimer / Sauvegarder en PDF
                </button>
            </div>
        </div>
    </Section>
</PageLayout>

<style>
    .cv-section {
        max-width: 920px;
        margin-inline: auto;
    }

    .cv-header {
        text-align: center;
        margin-block-end: var(--space-8);
        padding: var(--space-8);
    }

    .cv-header h1 {
        font-size: var(--text-4xl);
        margin-block-end: var(--space-2);
        color: var(--color-text);
    }

    .cv-subtitle {
        font-size: var(--text-lg);
        color: var(--color-primary);
        font-weight: 600;
        margin-block-end: var(--space-4);
    }

    .cv-objective {
        max-width: 700px;
        margin-inline: auto;
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        background: hsla(168, 62%, 52%, 0.08);
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-md);
        margin-block-end: var(--space-4);
        border-left: 3px solid var(--color-primary);
        line-height: 1.6;
    }

    .cv-contact {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-3);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        flex-wrap: wrap;
        margin-block-end: var(--space-4);
    }

    .cv-badges {
        display: flex;
        justify-content: center;
        gap: var(--space-2);
        flex-wrap: wrap;
    }

    .badge-tag {
        font-size: var(--text-xs);
        padding: 3px 10px;
        border-radius: var(--radius-full);
        background: var(--color-background-secondary);
        border: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        font-weight: 500;
    }

    .cv-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
    }

    .cv-block {
        padding: var(--space-8);
    }

    .cv-block__title {
        font-size: var(--text-2xl);
        color: var(--color-primary);
        margin-block-end: var(--space-6);
        padding-block-end: var(--space-2);
        border-bottom: 1px solid var(--color-border);
    }

    .cv-item {
        margin-block-end: var(--space-8);
    }

    .cv-item:last-child {
        margin-block-end: 0;
    }

    .cv-item__header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-4);
        margin-block-end: var(--space-1);
    }

    .cv-item__title {
        font-size: var(--text-lg);
        font-weight: 700;
        color: var(--color-text);
    }

    .cv-item__date {
        font-size: var(--text-xs);
        color: var(--color-primary);
        font-weight: 600;
        white-space: nowrap;
    }

    .cv-item__subtitle {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        font-style: italic;
        margin-block-end: var(--space-2);
    }

    .cv-item__description {
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin-block-end: var(--space-2);
        font-size: var(--text-sm);
    }

    .cv-item__list {
        list-style: none;
        padding-left: 0;
        color: var(--color-text-secondary);
        font-size: var(--text-sm);
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .cv-item__list li {
        position: relative;
        padding-left: var(--space-5);
        line-height: 1.6;
    }

    .cv-item__list li::before {
        content: "–";
        position: absolute;
        left: 0;
        color: var(--color-primary);
        font-weight: 700;
    }

    .cv-skills {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: var(--space-6);
    }

    .cv-skill-group h3 {
        font-size: var(--text-sm);
        font-weight: 700;
        color: var(--color-text);
        margin-block-end: var(--space-2);
    }

    .cv-skill-group p {
        font-size: var(--text-xs);
        color: var(--color-text-secondary);
        line-height: 1.7;
    }

    .cv-qualities {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }

    .cv-quality {
        padding: var(--space-2) var(--space-4);
        background: hsla(168, 75%, 28%, 0.07);
        border: 1px solid hsla(168, 75%, 28%, 0.18);
        border-radius: var(--radius-full);
        font-size: var(--text-xs);
        font-weight: 600;
        color: hsl(168, 85%, 23%);
    }

    :global([data-theme="dark"]) .cv-quality {
        background: hsla(168, 62%, 52%, 0.12);
        border-color: hsla(168, 62%, 52%, 0.25);
        color: var(--color-primary);
    }

    .cv-footer {
        display: flex;
        justify-content: center;
        gap: var(--space-4);
        margin-block-start: var(--space-4);
        flex-wrap: wrap;
    }

    @media print {
        .cv-footer,
        :global(header),
        :global(footer),
        :global(.opportunity-banner) {
            display: none !important;
        }

        .cv-section {
            max-width: 100%;
        }

        .bento-card {
            border: 1px solid #ccc !important;
            box-shadow: none !important;
            background: #fff !important;
            color: #000 !important;
        }

        body {
            background: #fff !important;
            color: #000 !important;
        }
    }

    @media (max-width: 768px) {
        .cv-item__header {
            flex-direction: column;
            gap: 2px;
        }
    }
</style>
